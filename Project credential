#=============================================Azure OpenAI (direct)================================
# The two generation-parameter dialects. gpt-5 / o-series deployments take the 'reasoning' set;
# the gpt-4o family takes the 'legacy' set and rejects the reasoning one. LLM_PARAM_STYLE picks
# the starting dialect and _chat flips to the other ONCE if the deployment refuses it, so the
# function keeps working if the deployment is ever swapped to a different model family.
_STYLE_REASONING = "reasoning"                  # max_completion_tokens + reasoning_effort, no temperature  # gpt-5 dialect
_STYLE_LEGACY = "legacy"                        # max_tokens + temperature  # gpt-4o dialect


# Markers seen in the error body when a deployment rejects a generation parameter. Used to flip
# dialect once per worker, not per call.
_UNSUPPORTED_PARAM_MARKERS = (                  # matched case-insensitively against the error text  # marker list
    "unsupported_parameter",                    # Azure OpenAI error code for a rejected parameter  # code marker
    "unsupported parameter",                    # same thing in the human-readable message  # message marker
    "unsupported_value",                        # error code when a value (not the key) is refused  # value code marker
    "unsupported value",                        # e.g. "'temperature' does not support 0 with this model"  # value message marker
    "max_completion_tokens",                    # named when max_tokens is refused  # tokens marker
    "'max_tokens'",                             # named when max_completion_tokens is expected instead  # legacy tokens marker
    "'temperature'",                            # named when a fixed-temperature model refuses it  # temperature marker
    "reasoning_effort",                         # named when a non-reasoning model refuses it  # reasoning marker
)


# True when `exc` looks like "this deployment does not accept that generation parameter".
# Kept narrow on purpose: anything else must propagate so the normal fallbacks still fire.
def _is_unsupported_parameter_error(exc: Exception) -> bool:    # exc: the exception the SDK raised  # param error probe
    text = str(exc).lower()                     # error bodies vary by SDK version, so match on text  # normalise
    return any(marker in text for marker in _UNSUPPORTED_PARAM_MARKERS)  # any marker is enough  # probe result


# The plain OpenAI client with the Entra ID token supplied per request.
#
# Why NOT openai.AzureOpenAI: on the /openai/v1 surface, AzureOpenAI._build_request rewrites the
# path to '/openai/v1/deployments/<model>/chat/completions', which is the LEGACY Azure route and
# 404s against v1. The plain client performs no path rewriting, so the endpoint from App Settings
# is used exactly as configured - and the behaviour is identical on openai 1.x and 2.x.
#
# `auth_headers` is re-read by the SDK on EVERY request, so overriding it here is what keeps the
# token fresh: get_bearer_token_provider caches internally and only re-fetches near expiry, which
# makes this a dictionary lookup on the warm path rather than a token call.
class _EntraIdOpenAI(OpenAI):               # OpenAI client authenticated with managed identity  # entra client

    # token_provider: callable returning a valid bearer token (from get_bearer_token_provider).
    def __init__(self, *, token_provider, **kwargs):    # kwargs pass straight through to OpenAI  # constructor
        self._token_provider = token_provider   # kept so auth_headers can call it per request  # token source
        # A placeholder api_key satisfies the base constructor; auth_headers below is what ships.
        super().__init__(api_key="managed-identity", **kwargs)   # build the underlying HTTP client  # init base

    # NOTE: this client is not copy()/with_options()-able, because those rebuild it without
    # token_provider. Nothing in this module needs them - the timeout/retry policy is set here.
    @property                               # the SDK reads this property on every request  # property
    def auth_headers(self) -> Dict[str, str]:    # -> the Authorization header for this request  # auth headers
        return {"Authorization": f"Bearer {self._token_provider()}"}  # cached token, refreshed near expiry  # bearer token


# Service wrapper around the Azure OpenAI model that powers BOTH language DETECTION and
# TRANSLATION. The model is called DIRECTLY over Chat Completions - one round-trip per request,
# no name resolution, no conversation object - with a per-call timeout + retries so transient
# failures cannot hang the Function.
class LlmService:                  # LLM engine for detection AND translation  # llm wrapper

    # config: model configuration (Azure OpenAI endpoint + deployment + api-version).
    # credential: Entra ID credential from get_default_credential().
    def __init__(self, config: LlmConfig, credential):    # builds the one client this service uses  # constructor
        self.config = config                    # endpoint + deployment used by every call  # keep config
        self.openai = _EntraIdOpenAI(            # single client, reused for every request on this worker  # build client
            token_provider=get_bearer_token_provider(credential, AZURE_OPENAI_SCOPE),    # managed identity, auto-refreshed  # auth
            base_url=config.openai_endpoint,    # the /openai/v1 surface, used exactly as configured  # base url
            default_query=(                 # the v1 surface takes api-version as a query parameter  # default query
                {"api-version": config.api_version} if config.api_version else None   # omitted when blanked out  # api version
            ),
            timeout=LLM_TIMEOUT_SECONDS,    # never let one slow call pin a Function worker  # timeout
            max_retries=LLM_MAX_RETRIES,    # transparent retries on transient 429/5xx  # retries
        )
        # Starting dialect. Flipped ONCE, in _chat, if the deployment rejects it.
        self._param_style = (                   # 'reasoning' unless explicitly configured otherwise  # param style
            _STYLE_LEGACY if LLM_PARAM_STYLE == _STYLE_LEGACY else _STYLE_REASONING   # anything else -> reasoning  # resolve style
        )

    # Build the generation parameters for the current dialect. Separated from _chat so the retry
    # path can simply rebuild them after flipping style, rather than patching keys in place.
    def _generation_params(self, max_tokens: int) -> Dict[str, Any]:    # max_tokens: the output ceiling  # params builder
        if self._param_style == _STYLE_REASONING:    # gpt-5 / o-series dialect  # reasoning style
            params: Dict[str, Any] = {"max_completion_tokens": max_tokens}   # reasoning models require this name  # output bound
            if LLM_REASONING_EFFORT:            # blank the App Setting to let the model default apply  # effort set
                # 'minimal' matters for latency: both modes are short mechanical tasks, so any
                # reasoning budget spent here is pure added time for no accuracy gain.
                params["reasoning_effort"] = LLM_REASONING_EFFORT     # minimal|low|medium|high  # reasoning effort
            # NOTE: no temperature. Reasoning deployments accept only the default and 400 otherwise.
            return params                       # reasoning-dialect parameters  # return params
        return {                                # gpt-4o dialect  # legacy style
            "max_tokens": max_tokens,           # bounds decode steps, so it bounds latency and cost  # output bound
            "temperature": LLM_TEMPERATURE,     # 0 by default: same input -> same output  # temperature
        }

    # Issue ONE Chat Completions call and return the assistant text, or None when nothing usable
    # came back. This is the single upstream hop shared by both modes: the system prompt carries
    # the instruction and the user message carries the data, so the two never blur together.
    def _chat(                              # one LLM round-trip, shared by both modes  # llm call
        self, system_prompt: str, user_text: str, max_tokens: int     # instruction + data + output bound  # arguments
    ) -> Optional[str]:                     # reply text, or None when unusable  # return type
        started = time.perf_counter()           # stopwatch for the upstream latency telemetry  # start timer
        base: Dict[str, Any] = {                 # the half of the payload that never varies  # request payload
            "model": self.config.deployment,    # on Azure the `model` argument is the deployment name  # deployment
            "messages": [                   # instruction and data travel as separate roles  # messages
                {"role": "system", "content": system_prompt},     # the instruction for this mode  # system turn
                {"role": "user", "content": user_text},   # the caller's raw text, never interpolated into the prompt  # user turn
            ],
        }

        try:                                # first attempt, in the current dialect  # guard call
            response = self.openai.chat.completions.create(**base, **self._generation_params(max_tokens))   # the single upstream hop  # create completion
        except Exception as exc:                # only ONE class of failure is handled here  # any error
            if not _is_unsupported_parameter_error(exc):     # not a parameter problem  # unrelated failure
                raise                           # let the caller's fallback / 502 handling deal with it  # propagate
            # The deployment belongs to the other model family. Flip dialect and remember it for the
            # life of the worker, so only the very first call ever pays for this extra round-trip.
            flipped = _STYLE_LEGACY if self._param_style == _STYLE_REASONING else _STYLE_REASONING   # the other dialect  # flip style
            logger.warning("Deployment '%s' rejected the '%s' parameters; switching to '%s'.",   # note the degrade  # warn ops
                           self.config.deployment, self._param_style, flipped)    # which deployment and which way  # values
            self._param_style = flipped         # latched for this worker  # store style
            response = self.openai.chat.completions.create(**base, **self._generation_params(max_tokens))   # retry in the other dialect  # create completion

        elapsed_ms = round((time.perf_counter() - started) * 1000)   # upstream latency in milliseconds  # stop timer
        reply = self._extract_reply_text(response)   # pull the assistant text out of the result  # extract reply
        finish_reason = self._extract_finish_reason(response)     # 'stop' normally, 'length' when truncated  # finish reason

        if finish_reason == "length":            # the output ceiling cut the reply short  # truncated
            if not reply:                       # nothing came back AT ALL  # empty reply
                # Diagnostic worth separating: on a reasoning deployment this means the whole
                # budget went on reasoning tokens before any answer was emitted. The fix is a
                # bigger cap or a lower LLM_REASONING_EFFORT, NOT a prompt change.
                logger.error(               # an empty reply is a failure, not a warning  # error log
                    "Empty reply: the %s-token budget was consumed before any output "     # message template  # template
                    "(reasoning_effort=%s). Raise the cap or lower the effort.",   # actionable advice  # template
                    max_tokens, LLM_REASONING_EFFORT or "default",    # the cap and the effort in play  # values
                    extra={"finish_reason": finish_reason, "max_tokens": max_tokens},  # structured fields  # telemetry
                )
            else:                               # partial output came back  # truncated reply
                # Surfaced rather than hidden: a truncated translation is a wrong translation.
                logger.warning("Reply hit the %s-token output ceiling; it may be truncated.",    # note the truncation  # warn ops
                               max_tokens, extra={"finish_reason": finish_reason})   # structured field for querying  # telemetry

        logger.info(                            # success log carrying latency and reply size  # info log
            "LLM call completed (llm_ms=%s, reply_len=%s, finish_reason=%s).",   # message template  # template
            elapsed_ms, len(reply) if reply else 0, finish_reason,    # latency, reply length and stop cause  # values
            extra={                             # structured fields for querying  # telemetry
                "llm_ms": elapsed_ms,           # upstream latency  # latency
                "reply_len": len(reply) if reply else 0,     # output size for cost analysis  # reply length
                "deployment": self.config.deployment,   # which model answered  # deployment
                "finish_reason": finish_reason,  # why generation stopped  # finish reason
            },
        )
        return reply                            # assistant reply, or None when it carried no text  # return reply

    # Pull the assistant's text out of a Chat Completions result. The plain `.content` string is
    # the normal case; the block-list branch keeps the code working on SDK builds (and models)
    # that return typed content parts instead.
    @staticmethod                           # no instance state is needed  # static helper
    def _extract_reply_text(response) -> Optional[str]:    # response -> assistant text  # reply extractor
        for choice in getattr(response, "choices", None) or []:   # iterate the choices safely  # walk choices
            content = getattr(getattr(choice, "message", None), "content", None)     # the assistant text  # read content
            if isinstance(content, str):        # the normal case: one plain string  # string content
                if content.strip():             # ignore an all-whitespace reply  # got text
                    return content.strip()      # trimmed reply  # return reply
                continue                        # blank choice -> try the next one  # skip
            parts = []                          # collected text blocks, in order  # accumulator
            for block in content or []:         # iterate the typed content parts safely  # walk blocks
                value = getattr(block, "text", None)     # object-shaped block  # block text
                if value is None and isinstance(block, dict):    # dict-shaped block  # dict block
                    value = block.get("text")   # read the text key  # block text
                if value:                       # ignore empty blocks  # got text
                    parts.append(value)         # keep it for the join below  # collect
            combined = "".join(parts).strip()    # stitch the blocks back together  # join text
            if combined:                        # this choice carried usable text  # got text
                return combined                 # trimmed reply  # return reply
        return None                             # blank -> None so callers can fall back  # return reply

    # Why generation stopped ('stop' | 'length' | 'content_filter' | ...), or None when the build
    # does not report it. Read defensively because it is only ever used for telemetry.
    @staticmethod                           # no instance state is needed  # static helper
    def _extract_finish_reason(response) -> Optional[str]:    # response -> finish reason  # reason extractor
        for choice in getattr(response, "choices", None) or []:   # iterate the choices safely  # walk choices
            return getattr(choice, "finish_reason", None)     # the first choice is the one we used  # return reason
        return None                             # no choices came back at all  # unknown

    # Identify the language of `text` using the LLM, returning the SAME shape as
    # LanguageDetector.detect() (plus 'engine') so the caller need not know which engine ran.
    # Any LLM failure or unparsable reply degrades to the offline detector, never a 5xx.
    def detect_language(self, text: str) -> Dict[str, Any]:    # confidence is None on the LLM path  # LLM detect
        text = (text or "").strip()             # normalise None and surrounding whitespace  # normalise input
        if not text:                            # empty input carries no language  # nothing to detect
            result = LanguageDetector._supported("en", None, text)  # nothing to detect  # default English
            result["engine"] = "rule"           # produced without an LLM call  # engine tag
            return result                       # early return, no upstream call  # respond

        # Fast, deterministic rejects: these save an LLM round-trip and can never be misread.
        if _DEVANAGARI.search(text):            # Devanagari characters present  # script check
            result = LanguageDetector._rejected("hi", None, text)   # report as Hindi and reject  # reject
            result["engine"] = "rule"           # produced without an LLM call  # engine tag
            return result                       # early return, no upstream call  # respond
        if _ARABIC.search(text):                # Arabic-script characters present  # script check
            result = LanguageDetector._rejected("ar", None, text)   # report as Arabic and reject  # reject
            result["engine"] = "rule"           # produced without an LLM call  # engine tag
            return result                       # early return, no upstream call  # respond

        try:                                # any upstream failure degrades to the offline engine  # guard call
            code = self._detect_code_via_llm(text)      # ask the LLM for an ISO 639-1 code  # call model
        except Exception:                       # any model-side failure  # upstream error
            # Any upstream failure degrades to the offline engine, never a 5xx.
            logger.exception("LLM language detection failed; using offline detector.")   # full stack for ops  # error log
            return _DETECTOR.detect(text)       # offline result keeps the endpoint up  # fallback

        if not code:                            # the reply could not be parsed  # unusable reply
            # Reply could not be parsed into a code -> fall back rather than guess.
            logger.warning("Could not read a language code from the LLM; using offline detector.")   # note the fallback  # warn
            return _DETECTOR.detect(text)       # offline result rather than a guess  # fallback

        code = LANG_ALIASES.get(code, code)     # normalise aliases (jp -> ja, ...)  # apply aliases
        if code in SUPPORTED:                   # the detected language is one we serve  # supported
            result = LanguageDetector._supported(code, None, text)  # success payload  # accept
        else:                                   # detected but not served  # unsupported
            result = LanguageDetector._rejected(code, None, text)   # reject payload  # reject
        result["engine"] = "foundry"            # produced by the LLM engine  # engine tag
        return result                           # same shape as the offline detector  # respond

    # Ask the model to name the language and return its ISO 639-1 code, or None when the reply
    # was unusable. Only the opening DETECT_SAMPLE_CHARS characters are sent: a language is
    # identifiable from the first sentence, so shipping a 5000-character message would be paying
    # prompt tokens and prefill latency for nothing.
    def _detect_code_via_llm(self, text: str) -> Optional[str]:    # text: the message whose language we want  # code via LLM
        sample = text[:DETECT_SAMPLE_CHARS]     # opening slice is enough to identify the language  # trim input
        reply = self._chat(                     # single LLM round-trip  # call model
            DETECT_SYSTEM_PROMPT,               # narrow classifier instruction, not the persona  # system prompt
            sample,                             # the text whose language we want  # user text
            DETECT_MAX_TOKENS,                  # a two-letter answer needs almost no decode budget  # output bound
        )
        return self._parse_language_code(reply)     # turn the free-text reply into a code  # parse reply

    # Best-effort extraction of a language code from the model's free-text reply. A single-token
    # reply is trusted; a code buried in a sentence is NOT (codes like 'hi', 'he', 'it', 'id' are
    # also common English words), so multi-word replies only match an unambiguous display NAME.
    @staticmethod                           # no instance state is needed  # static helper
    def _parse_language_code(reply: Optional[str]) -> Optional[str]:    # reply: the model's free-text answer  # reply parser
        if not reply:                           # nothing came back from the model  # empty reply
            return None                         # caller falls back to the offline detector  # give up
        cleaned = re.sub(r"[^a-z\s]", " ", reply.strip().lower()).strip()    # strip punctuation/case  # normalise reply
        if not cleaned:                         # reply held no letters at all  # nothing usable
            return None                         # caller falls back to the offline detector  # give up
        words = cleaned.split()                 # tokenise so we can spot a single-token reply  # tokenise
        known_codes = set(SUPPORTED) | set(DECOYS) | set(LANG_ALIASES)   # every code we recognise  # known codes

        # 1. The instructed happy path: the reply IS just the code (single token).
        if len(words) == 1:                     # exactly what the model was told to return  # single token
            token = words[0]                    # the candidate code  # candidate
            if token in known_codes:            # a code we already track  # known code
                return token                    # trusted match  # return code
            if len(token) == 2 and token.isalpha():     # looks like an ISO 639-1 code  # code shaped
                return token  # a valid-looking code we do not otherwise track (e.g. 'fi')  # return code

        # 2. A display NAME anywhere ('...is Japanese') - unambiguous, so safe inside a sentence.
        for code, name in SUPPORTED.items():    # walk the supported languages  # name match
            if name.lower() in cleaned:         # the display name appears in the reply  # found name
                return code                     # map the name back to its code  # return code

        # 3. Give up -> the caller falls back to the offline detector.
        return None                             # nothing usable was found  # give up

    # Translate `text` into `target_language` using the model. The system prompt carries the
    # persona plus a task block instructing it to return ONLY the translation, so the reply can be
    # used verbatim. Returns the translated text, or None if nothing was produced.
    def translate_message(self, text: str, target_language: str) -> Optional[str]:    # text + target language -> translated text  # LLM translate
        logger.info("Translating message into %s via Azure OpenAI.", target_language,     # note the target language  # info log
                    extra={"target_language": target_language})     # structured field for querying  # telemetry
        reply = self._chat(                     # single LLM round-trip  # call model
            build_translate_system_prompt(target_language),   # persona + this-turn task override  # system prompt
            text,                               # the message to translate  # user text
            TRANSLATE_MAX_TOKENS,               # room for a full translation in any script  # output bound
        )
        if not reply:                           # upstream gave us nothing usable  # empty reply
            # Upstream returned nothing usable; the caller turns this into a 502.
            logger.warning("Azure OpenAI did not return any translated text.")     # note the failure  # warn
        return reply                            # translated text, or None on failure  # return reply


#=====================================Cached LLM service===========================================
_service_lock = threading.Lock()                # guards the one-time build for the concurrent worker  # build lock
# The service AND the config it was built from live in ONE tuple slot, so a warm reader can never
# see a service paired with someone else's key: rebinding one name is atomic, rebinding two is not.
_llm_service_cache: Optional[tuple] = None  # (key, service); built ONCE per worker, the client is expensive  # cache slot


# Return a cached LlmService, (re)building it only when config changes. Building the
# client per request would add token acquisition + TLS setup to every call; caching keeps warm
# invocations fast without pinning stale configuration.
def get_llm_service(llm_cfg: LlmConfig) -> LlmService:    # llm_cfg: the config the service must match  # cached accessor
    global _llm_service_cache               # the module-level cache is rebound here  # globals
    key = (llm_cfg.openai_endpoint, llm_cfg.deployment, llm_cfg.api_version)   # identity of the current config  # cache key

    # Cheap read first: a valid cache is reused without taking the lock.
    cached = _llm_service_cache             # single read of a single name -> key and service always agree  # snapshot
    if cached is not None and cached[0] == key:  # cache is present and still valid  # cache hit
        return cached[1]                        # warm path, no lock taken  # reuse service
    with _service_lock:                         # serialise concurrent first calls  # take lock
        cached = _llm_service_cache         # re-read inside the lock  # snapshot
        if cached is None or cached[0] != key:   # re-test in case another thread built it  # double check
            logger.info("Building Azure OpenAI client (first use or config change).")    # note the cold build  # info log
            credential = get_default_credential()   # managed identity in Azure  # credential
            cached = (key, LlmService(llm_cfg, credential))   # build the service once  # build service
            _llm_service_cache = cached     # publish key + service together  # store cache
        return cached[1]                        # freshly built or built by another thread  # return service


#==============================================Azure Function Entry================================
def main(req: func.HttpRequest) -> func.HttpResponse:
    """
    HTTP-triggered Azure Function entry point.

    Responsibilities:
    - Validate and parse the incoming request [query string OR JSON body].
    - Route the request by the 'agent' field:
        'detect'    -> detect the language (direct LLM call; offline fallback) and return it.
        'translate' -> translate 'message' into the target 'lang' via a direct LLM call.
    - Load configuration and authenticate using managed identity.
    - Emit structured telemetry (latency, engine, sizes) and return a JSON response.

    Why:
    - This function is the single entry point for the multilingual experience, so it
      centralises input validation, correlation and telemetry while avoiding embedded
      secrets and never leaking internal exception detail to the caller.

    Returns:
    - func.HttpResponse with a JSON body carrying the correlation_id on EVERY path.
      HTTP status codes:
        200 - success (detect or translate).
        400 - input error (missing message / mode, oversized input, unsupported lang).
        502 - the upstream model produced no usable result (translate).
        500 - unhandled server error.
    """
    # Correlate every log line for this request; honour a (validated) caller-supplied id.
    correlation_id = sanitize_correlation_id(req.headers.get("x-correlation-id"))    # caller id or a fresh UUID  # correlation id
    _correlation_id_var.set(correlation_id)     # publish it so the log filter picks it up  # context var
    request_started = time.perf_counter()       # stopwatch for the end-to-end latency telemetry  # start timer
    logger.info("Request received for Multilingual Agent function.",     # entry log for every request  # entry log
                extra={"correlation_id": correlation_id})   # structured field for querying  # telemetry

    # Top-level guard: any unexpected error becomes a 500 instead of a leaked stack trace.
    try:                                    # guard for unexpected exceptions  # safety net
        # 1. Parse the JSON body once and work out which mode was requested.
        body = get_json_body(req)               # {} when the body is absent or invalid  # read body
        llm_mode = extract_llm_mode(req, body)   # 'detect' | 'translate' | None  # read mode

        # 2. Read the user message [required for both modes] and bound its size.
        user_message = extract_message(req, body)   # query string or body, aliases accepted  # read message
        if not user_message or not str(user_message).strip():    # missing or blank message  # validate presence
            return error_response(              # 400 so the client can correct the payload  # respond bad request
                "Input Error.",                 # short, stable message for the client  # message
                "message is required [query string or JSON body].",  # says exactly what was missing  # details
                400, correlation_id,            # status plus the trace id  # status + trace
            )
        user_message = str(user_message)        # normalise to str for the length check below  # coerce type
        if len(user_message) > MAX_MESSAGE_CHARS:    # oversized input bounds cost / abuse  # validate size
            return error_response(              # 400 so the client can shorten the input  # respond bad request
                "Input Error.",                 # short, stable message for the client  # message
                f"message exceeds the maximum length of {MAX_MESSAGE_CHARS} characters.",    # states the limit  # details
                400, correlation_id,            # status plus the trace id  # status + trace
            )

        # 3a. DETECT mode -> direct LLM call, falling back offline so this endpoint never goes down.
        if llm_mode == "detect":              # caller asked only for the language  # detect mode
            try:                            # LLM path, with the offline fallback below  # guard call
                config = load_config()          # endpoint, deployment and environment  # load config
                llm_service = get_llm_service(config.llm)    # cached service instance  # get service
                detection = llm_service.detect_language(user_message)    # LLM based detection  # detect
            except Exception:                   # config or model side failure  # any error
                logger.exception("LLM detection unavailable; using offline detector.")    # full stack for ops  # error log
                detection = _DETECTOR.detect(user_message)   # offline result keeps the endpoint up  # fallback

            # Structured completion log so engine / outcome / latency stay queryable.
            logger.info(                        # one completion log per detect request  # info log
                "detect complete.",             # stable message text for querying  # message
                extra={                         # structured fields, not string-formatted  # telemetry
                    "agent": "detect",          # which mode served the request  # mode
                    "engine": detection.get("engine"),      # 'foundry' | 'offline' | 'rule'  # engine
                    "code": detection.get("code"),  # detected ISO 639-1 code  # code
                    "supported": detection.get("supported"),    # whether we serve that language  # supported flag
                    "msg_len": len(user_message),   # input size for cost analysis  # message length
                    "total_ms": round((time.perf_counter() - request_started) * 1000),   # end-to-end latency  # latency
                },
            )
            return json_response(               # 200 with the detection result  # success response
                {                           # detect success body  # payload
                    "Success": True,            # indicate success to the caller  # result
                    "agent": "detect",          # echo which mode ran  # mode
                    "supported": detection["supported"],    # whether we serve that language  # supported flag
                    "language": detection["language"],      # null when unsupported  # language
                    "code": detection["code"],  # detected ISO 639-1 code  # code
                    "confidence": detection["confidence"],   # null on the LLM path  # confidence
                    "engine": detection.get("engine"),  # which engine produced the answer  # engine
                    "correlation_id": correlation_id,   # trace id on every response  # trace id
                    "message": detection["message"],        # populated only when unsupported  # message
                }
            )

        # 3b. TRANSLATE mode -> translate the message into the requested language.
        if llm_mode == "translate":           # caller asked for a translation  # translate mode
            target_language = resolve_language(extract_lang(req, body))   # token -> supported display name  # resolve lang
            if not target_language:             # missing or unsupported target language  # validate lang
                return error_response(          # 400 listing the supported languages  # respond bad request
                    "Input Error.",             # short, stable message for the client  # message
                    "'lang' is required for translate and must be a supported language. "    # says what is wrong  # details
                    + NOT_SUPPORTED_MESSAGE,    # append the agreed list of supported languages  # supported list
                    400, correlation_id,        # status plus the trace id  # status + trace
                )

            # Load configuration + cached service, then call the model directly.
            config = load_config()              # endpoint, deployment and environment  # load config
            llm_service = get_llm_service(config.llm)    # cached service instance  # get service
            reply = llm_service.translate_message(user_message, target_language)     # translate via the LLM  # translate

            if not reply:                       # upstream produced nothing usable  # empty reply
                # Upstream produced nothing usable -> tell the caller to retry (502).
                return error_response(          # 502 marks this as an upstream failure  # respond bad gateway
                    "Translation failed.",      # short, stable message for the client  # message
                    "The translation service did not return a result. Please retry.",    # actionable advice  # details
                    502, correlation_id,        # status plus the trace id  # status + trace
                )

            # Structured completion log so latency and payload sizes stay queryable.
            logger.info(                        # one completion log per translate request  # info log
                "translate complete.",          # stable message text for querying  # message
                extra={                         # structured fields, not string-formatted  # telemetry
                    "agent": "translate",       # which mode served the request  # mode
                    "target_language": target_language,     # language we translated into  # target
                    "msg_len": len(user_message),   # input size for cost analysis  # message length
                    "reply_len": len(reply),    # output size for cost analysis  # reply length
                    "total_ms": round((time.perf_counter() - request_started) * 1000),   # end-to-end latency  # latency
                },
            )
            return json_response(               # 200 with the translated text  # success response
                {                           # translate success body  # payload
                    "Success": True,            # indicate success to the caller  # result
                    "agent": "translate",       # echo which mode ran  # mode
                    "language": target_language,    # language we translated into  # target
                    "environment": config.environment,  # environment string used by the function  # env
                    "correlation_id": correlation_id,   # trace id on every response  # trace id
                    "reply": reply,             # the translated text, usable as-is  # translation
                }
            )

        # 4. Missing / unknown agent -> tell the caller the valid options.
        return error_response(                  # 400 because the mode is part of the contract  # respond bad request
            "Input Error.",                     # short, stable message for the client  # message
            "agent is required and must be 'detect' or 'translate'.",     # lists the valid options  # details
            400, correlation_id,                # status plus the trace id  # status + trace
        )

    except Exception:                           # catch-all so no stack trace ever reaches a client  # safety net
        logger.exception("Unhandled exception in Multilingual Agent function.")  # full stack server-side only, never to the caller  # error log
        return error_response(                  # 500 indicates a server-side fault  # server error response
            "Unhandled server error. Please contact the automation team.",    # what the user should do  # message
            f"An unexpected error occurred. Quote correlation_id '{correlation_id}' to support.",     # no internal detail  # details
            500, correlation_id,                # status plus the trace id  # status + trace
        )
