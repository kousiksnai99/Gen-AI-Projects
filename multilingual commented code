#==============================================Utilities===========================================
# Build a JSON HTTP response. ensure_ascii=False keeps non-Latin scripts (Hebrew, Japanese,
# Chinese, ...) readable in the body instead of being escaped to \uXXXX. Centralising response
# construction keeps the contract identical on every path.
def json_response(payload: Dict[str, Any], status: int = 200) -> func.HttpResponse:    # payload: body to serialise, status: HTTP status  # response writer
    return func.HttpResponse(                   # single place where every response is constructed  # build response
        body=json.dumps(payload, ensure_ascii=False),   # serialise without escaping non-Latin scripts  # JSON body
        status_code=status,                     # HTTP status requested by the caller  # status code
        mimetype="application/json",            # tell clients the body is JSON  # content type
    )


# Standard error envelope. Always carries the correlation_id so callers can quote it: one shape
# for every failure means clients need a single error parser, and support can always trace a
# complaint back to the exact request via the correlation id.
def error_response(                         # one envelope shape for every failure  # error writer
    message: str, details: str, status: int, correlation_id: str     # user-facing message, detail, status, trace id  # arguments
) -> func.HttpResponse:                     # always a JSON HttpResponse  # return type
    return json_response(                       # reuse the standard JSON writer  # delegate
        {                                   # uniform error body the clients parse  # payload
            "Success": False,                   # uniform failure flag for every error path  # result
            "error": {"message": message, "details": details},  # short message plus safe detail  # error block
            "correlation_id": correlation_id,   # lets the caller quote the request to support  # trace id
        },
        status=status,                          # 400 / 502 / 500 as decided by the caller  # status code
    )


# Create the credential used to authenticate against the Foundry endpoint, whose 'projects'
# API accepts Microsoft Entra ID (AAD) tokens only. Managed identity avoids embedded secrets
# entirely; there is nothing to rotate or leak.
def get_default_credential():               # Entra ID credential for the Foundry endpoint  # credential factory
    tenant_id = os.getenv("AZURE_TENANT_ID") or None    # AZURE_TENANT_ID targets a specific directory locally  # tenant

    # Local, developer-only interactive sign-in path, handy when the Azure CLI is unavailable.
    if os.getenv("LOCAL_INTERACTIVE_LOGIN", "").lower() in ("1", "true", "yes"):    # only ever set on a dev box, never in Azure  # local flag
        from azure.identity import InteractiveBrowserCredential   # imported lazily so Azure never pays for it  # local-only import

        logger.info("Using InteractiveBrowserCredential for local sign-in (tenant=%s).",   # make the path obvious in logs  # log path
                    tenant_id or "default")     # 'default' when no tenant was pinned  # tenant label
        return InteractiveBrowserCredential(tenant_id=tenant_id)    # browser based sign-in for local testing  # local credential

    # Deployed path: Managed Identity. Interactive/dev credential sources are
    # excluded so credential resolution is fast and deterministic in Azure.
    return DefaultAzureCredential(              # Managed Identity: SAME tenant as the project, 'Azure AI User' role  # managed identity
        exclude_interactive_browser_credential=True,    # never prompt inside a Function worker  # no prompts
        exclude_visual_studio_code_credential=True,     # dev-only source, irrelevant in Azure  # skip VS Code
        exclude_shared_token_cache_credential=True,     # dev-only source, irrelevant in Azure  # skip token cache
        exclude_powershell_credential=True,             # dev-only source, irrelevant in Azure  # skip PowerShell
    )


# Allowed shape of a caller-supplied correlation id: letters/digits/._- and at most 64 chars.
_CORRELATION_ID_RE = re.compile(r"[A-Za-z0-9._-]{1,64}\Z")  # whitelist pattern, anchored end to end  # id pattern


# Return a safe correlation id. A caller-supplied x-correlation-id is honoured ONLY if it is
# short and free of control characters (letters/digits/._- , <=64 chars); otherwise a fresh
# UUID4 is generated. This prevents log-injection / forged-trace attacks via a hostile header.
def sanitize_correlation_id(raw: Optional[str]) -> str:    # raw: the caller supplied header value  # id guard
    if raw and _CORRELATION_ID_RE.match(raw):   # honour the caller's id only when it is safe  # validate header
        return raw                              # validated caller id  # reuse caller id
    return str(uuid.uuid4())                    # newly generated id  # fresh UUID


# Parse the JSON body once; return {} when missing or invalid so callers can .get(). Both modes
# accept input from the query string as well, so an absent or malformed body is NOT an error by
# itself; it simply contributes no fields.
def get_json_body(req: func.HttpRequest) -> Dict[str, Any]:    # req: the incoming HttpRequest  # body reader
    try:                                    # a malformed body is not an error by itself  # guard parse
        body = req.get_json()                   # parse JSON payload from the HttpRequest object  # read JSON body
    except ValueError:                          # raised by get_json if payload is not valid JSON  # invalid JSON
        return {}                               # invalid JSON -> behave as if no body was sent  # empty dict
    return body if isinstance(body, dict) else {}   # only an object is usable; lists/scalars ignored  # normalise shape


# Read the mode ('detect' / 'translate') from the query string or body, lower-cased.
# Returns None when it was not supplied.
def extract_agent(req: func.HttpRequest, body: Dict[str, Any]) -> Optional[str]:    # req + body: the two accepted input sources  # mode reader
    agent = req.params.get("agent") or body.get("agent")    # query string wins over body  # read mode
    if isinstance(agent, str) and agent.strip():    # only a non-blank string is usable  # guard type
        return agent.strip().lower()            # normalised mode  # lower-cased
    return None                                 # not supplied  # missing mode


# Read the user message from the query string or JSON body (several keys accepted). Callers
# integrate from different tools, so the common aliases are accepted rather than forcing every
# client to rename its field. Returns None when no known key carried a value.
def extract_message(req: func.HttpRequest, body: Dict[str, Any]) -> Optional[str]:    # req + body: the two accepted input sources  # message reader
    message = req.params.get("message") or req.params.get("q") or req.params.get("query")   # query string aliases  # read query string
    if message:                                 # query string wins when it carried a value  # prefer query string
        return message                          # message taken from the URL  # return message
    return (                                    # otherwise fall through to the JSON body aliases  # read body
        body.get("message")                     # canonical body key  # message
        or body.get("query")                    # alias used by some callers  # query
        or body.get("text")                     # alias used by some callers  # text
        or body.get("prompt")                   # alias used by some callers  # prompt
    )


# Read the raw target language token for 'translate' (query string or body). The token is
# returned exactly as sent; resolution to a supported language happens in resolve_language().
def extract_lang(req: func.HttpRequest, body: Dict[str, Any]) -> Optional[str]:    # req + body: the two accepted input sources  # lang reader
    lang = (                                    # accept the token from either source, aliases included  # read lang
        req.params.get("lang")                  # canonical query string key  # query lang
        or req.params.get("language")           # long form in the query string  # query language
        or body.get("lang")                     # canonical body key  # body lang
        or body.get("language")                 # long form in the body  # body language
    )
    if isinstance(lang, str) and lang.strip():  # only a non-blank string is usable  # guard type
        return lang.strip()                     # raw token as sent by the caller  # return token
    return None                                 # absent  # missing lang


