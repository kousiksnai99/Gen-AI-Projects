#=============================Logging Setup========================================================
# Use a module-scoped logger (never mutate the root logger as an import side-effect, which would
# also change verbosity for the Azure SDKs / httpx and bypass host-side log configuration).
logger = logging.getLogger("multilingual_agent")    # named logger owned by this module  # module logger
logger.setLevel(getattr(logging, os.getenv("LOG_LEVEL", "INFO").upper(), logging.INFO))     # LOG_LEVEL App Setting wins, INFO otherwise  # verbosity

# The active request's correlation id, propagated to every log record via a filter so a single
# request can be traced end-to-end in Application Insights even under concurrent execution.
_correlation_id_var: "contextvars.ContextVar[str]" = contextvars.ContextVar(     # per-request storage, safe under concurrency  # context variable
    "correlation_id", default="-"               # '-' is used until a request sets a real id  # default value
)


# Inject the current correlation id onto every record so it surfaces in App Insights.
# Without this, correlation would have to be passed manually to every log call,
# which is easy to forget and impossible to enforce.
class _CorrelationIdFilter(logging.Filter):     # logging.Filter subclass used purely to enrich records  # log filter

    def filter(self, record: logging.LogRecord) -> bool:  # noqa: A003   # called by logging for every record  # enrich hook
        if not hasattr(record, "correlation_id"):   # never overwrite a caller-supplied value  # respect explicit extra=
            record.correlation_id = _correlation_id_var.get()   # stamp the current request's id onto the record  # attach id
        return True                             # this filter only enriches; it never drops a record  # always keep


logger.addFilter(_CorrelationIdFilter())        # register the filter once at import time  # wire it up


#=============================Tunables (env-overridable)===========================================
# Read an int App Setting, falling back to `default` on missing/invalid values,
# because a typo in an App Setting must never crash the Function at import time.
def _int_env(name: str, default: int) -> int:    # name: setting to read, default: value used when absent  # int reader
    try:                                    # a bad App Setting must never crash the Function at import  # guard parse
        return int(os.getenv(name, str(default)))    # parse the App Setting as an integer  # read setting
    except (TypeError, ValueError):             # missing or non-numeric value  # bad input
        return default                          # absent/unparsable -> safe default  # fallback


# Read a float App Setting, falling back to `default` on missing/invalid values.
# Same defensive reasoning as _int_env; timeouts must always resolve to a number.
def _float_env(name: str, default: float) -> float:    # name: setting to read, default: value used when absent  # float reader
    try:                                    # a bad App Setting must never crash the Function at import  # guard parse
        return float(os.getenv(name, str(default)))  # parse the App Setting as a float  # read setting
    except (TypeError, ValueError):             # missing or non-numeric value  # bad input
        return default                          # absent/unparsable -> safe default  # fallback


# Reject messages longer than this (characters) with a 400 - bounds LLM token cost / abuse.
MAX_MESSAGE_CHARS = _int_env("MAX_MESSAGE_CHARS", 5000)     # maximum accepted message length  # input bound
# Per-request timeout (seconds) applied to the Foundry/OpenAI client. Generous enough for a
# slow-but-legitimate translation, but well under the Azure Functions ~230s HTTP hard limit
# and the host.json functionTimeout so a hung upstream call cannot pin a worker indefinitely.
FOUNDRY_TIMEOUT_SECONDS = _float_env("FOUNDRY_TIMEOUT_SECONDS", 60.0)   # upstream call timeout  # timeout
# Automatic retries (SDK-level) on transient Foundry failures (429 / 5xx / timeouts). Kept low
# so worst-case (attempts x timeout) stays inside functionTimeout.
FOUNDRY_MAX_RETRIES = _int_env("FOUNDRY_MAX_RETRIES", 1)    # SDK-level retry attempts  # retries


