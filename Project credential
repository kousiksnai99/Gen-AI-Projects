def _normalise_openai_endpoint(endpoint: str) -> str:
    """
    Normalise whatever endpoint an operator typed into the v1 base URL the client needs.

    Accepts the full '.../openai/v1' form or a bare resource URL, because "which suffix does
    it want?" is an easy App Setting to get wrong and the failure would be a confusing 404.
    """
    endpoint = endpoint.strip().rstrip("/")
    if endpoint.endswith("/openai/v1"):
        return endpoint
    if endpoint.endswith("/openai"):
        return endpoint + "/v1"
    return endpoint + "/openai/v1"


def load_config() -> AppConfig:
    """
    Build the AppConfig from environment variables (App Settings) with safe defaults.

    Every value is overridable WITHOUT a code redeploy via
    Function App -> Configuration -> Application settings:

        AZURE_OPENAI_ENDPOINT    - the Azure OpenAI v1 endpoint ('direct' / key auth).
        FOUNDRY_ENDPOINT         - the Foundry project endpoint ('project' auth, the default).
        AZURE_OPENAI_DEPLOYMENT  - the model deployment name (default 'gpt-5-mini').
        AZURE_OPENAI_API_VERSION - api-version query parameter (default 'preview').
        LLM_AUTH_MODE            - 'project' (default) | 'direct'.
        ENVIRONMENT              - free-text label for the response (default 'dev').

    Returns:
        AppConfig: Fully-populated configuration object.
    """
    openai_endpoint = os.getenv("AZURE_OPENAI_ENDPOINT", _DEFAULT_OPENAI_ENDPOINT)
    deployment = os.getenv("AZURE_OPENAI_DEPLOYMENT", _DEFAULT_DEPLOYMENT)
    if not os.getenv("AZURE_OPENAI_DEPLOYMENT"):
        logger.info("AZURE_OPENAI_DEPLOYMENT not set; using the built-in default '%s'.",
                    _DEFAULT_DEPLOYMENT)
    auth_mode = "direct" if LLM_AUTH_MODE == "direct" else "project"
    foundry_cfg = FoundryConfig(
        openai_endpoint=_normalise_openai_endpoint(openai_endpoint),
        project_endpoint=os.getenv("FOUNDRY_ENDPOINT", _DEFAULT_PROJECT_ENDPOINT),
        deployment=deployment,
        api_version=os.getenv("AZURE_OPENAI_API_VERSION", _DEFAULT_API_VERSION),
        auth_mode=auth_mode,
    )
    return AppConfig(environment=os.getenv("ENVIRONMENT", "dev"), foundry=foundry_cfg)


#==============================================Utilities===========================================
def json_response(payload: Dict[str, Any], status: int = 200) -> func.HttpResponse:
    """
    Build a JSON HTTP response.

    ensure_ascii=False keeps non-Latin scripts (Hebrew, Japanese, Chinese, ...)
    readable in the body instead of being escaped to \\uXXXX.
    """
    return func.HttpResponse(
        body=json.dumps(payload, ensure_ascii=False),
        status_code=status,
        mimetype="application/json",
    )


def error_response(
    message: str, details: str, status: int, correlation_id: str
) -> func.HttpResponse:
    """Standard error envelope. Always carries the correlation_id so callers can quote it."""
    return json_response(
        {
            "Success": False,
            "error": {"message": message, "details": details},
            "correlation_id": correlation_id,
        },
        status=status,
    )


