    "Thai, Vietnamese, Turkish, Chinese (Mandarin), Chinese (Cantonese)"                # end of the list  # line 6
)

# Common non-ISO / colloquial aliases callers may send for the TARGET language
# (e.g. 'jp' for Japanese, 'kr' for Korean) -> the real ISO 639-1 code.
LANG_ALIASES: Dict[str, str] = {                # colloquial token -> real ISO 639-1 code  # alias map
    "jp": "ja",                                 # Japan -> Japanese  # jp
    "kr": "ko",                                 # Korea -> Korean  # kr
    "cn": "zh",                                 # China -> Chinese  # cn
    "gr": "el",                                 # Greece -> Greek  # gr
    "cz": "cs",                                 # Czechia -> Czech  # cz
    "ua": "uk",                                 # Ukraine -> Ukrainian  # ua
    # The SUPPORTED display name is "Chinese (Mandarin)", which a caller is unlikely to type
    # verbatim; accept the natural words. Written text cannot distinguish the two, so both
    # Mandarin and Cantonese resolve to the single 'zh' entry.
    "chinese": "zh",                            # natural word for the language  # chinese
    "mandarin": "zh",                           # spoken variety, same written form  # mandarin
    "cantonese": "zh",                          # spoken variety, same written form  # cantonese
}


# Resolve a caller token to a SUPPORTED display name, or None if unsupported. Accepts
# (case-insensitively) an ISO 639-1 code ('ja'), an alias ('jp') or the English display name
# ('Japanese'). None is what drives the 400 response in 'translate' mode.
def resolve_language(lang: Optional[str]) -> Optional[str]:    # lang: whatever token the caller sent  # lang resolver
    if not lang:                                # nothing supplied by the caller  # missing token
        return None                             # caller gets a 400 upstream  # unsupported
    key = lang.strip().lower()                  # normalise case and surrounding spaces  # normalise
    key = LANG_ALIASES.get(key, key)            # normalise aliases -> ISO code  # apply aliases
    if key in SUPPORTED:                        # a supported ISO code was supplied  # code match
        return SUPPORTED[key]                   # the display name the agent is told to use  # display name
    # Allow callers to pass the display name directly (e.g. 'Japanese').
    for name in SUPPORTED.values():             # walk the supported display names  # name match
        if name.lower() == key:                 # case-insensitive full name match  # compare
            return name                         # echo the canonical display name  # display name
    return None                                 # not a supported language  # unsupported


# Below this confidence, and not clearly English, we default to English
# (per the product rule: "if uncertain, respond in English").
_MIN_CONFIDENCE = 0.55                          # offline detector confidence floor  # threshold

# Scripts that NO supported language uses -> instant, guaranteed reject.
_DEVANAGARI = re.compile("[ऀ-ॿ]")            # Hindi, Marathi, Nepali...  # devanagari range
_ARABIC = re.compile("[؀-ۿݐ-ݿ]")   # Arabic, Urdu, Persian...  # arabic range


# Offline, deterministic language detector backed by py3langid: the FALLBACK engine used when
# the Foundry LLM cannot be reached. No LLM is involved, so it cannot hallucinate or reply in
# the wrong language - the same input always yields the same output.
class LanguageDetector:                     # offline fallback engine, no LLM involved  # detector

    # Defer all expensive setup so importing this module stays cheap.
    def __init__(self):                     # nothing expensive happens here  # constructor
        # The py3langid identifier is created on first use (see _get_identifier).
        self._identifier = None                 # built on first detect() call  # lazy model
        self._lock = threading.Lock()           # guards the one-time model build  # build lock

    # Lazy-load and cache the py3langid identifier (thread-safe), because loading it is
    # comparatively expensive. Restricted to the supported languages plus the decoys so
    # detection stays focused and unsupported languages are rejected explicitly.
    def _get_identifier(self):              # returns the cached py3langid model  # model accessor
        # Double-checked locking: cheap read first, lock only on the very first build.
        if self._identifier is None:            # nothing cached yet  # first use
            with self._lock:                    # serialise concurrent first calls  # take lock
                if self._identifier is None:    # re-test in case another thread built it  # double check
                    from py3langid.langid import LanguageIdentifier, MODEL_FILE   # imported lazily, it is expensive  # lazy import

                    identifier = LanguageIdentifier.from_pickled_model(     # load the pre-trained model  # build model
                        MODEL_FILE, norm_probs=True     # normalised probs give a usable confidence  # confidence
                    )
                    identifier.set_languages(list(SUPPORTED.keys()) + DECOYS)   # restrict to supported + decoys  # narrow scope
                    self._identifier = identifier   # cache for every later request  # cache model
        return self._identifier                 # cached LanguageIdentifier instance  # return model

    # Detect the language of `text` and report whether it is supported. Returns a dict with
    # keys: input, language, code, supported, confidence, message, engine ('offline').
    def detect(self, text: str) -> Dict[str, Any]:    # text: the message to classify  # offline detect
        text = (text or "").strip()             # normalise None and surrounding whitespace  # normalise input
        if not text:                            # empty input carries no language  # nothing to detect
            return self._supported("en", 1.0, text)  # nothing to detect -> English  # default English

        # Hard, deterministic rejects for scripts no supported language uses.
        if _DEVANAGARI.search(text):            # Devanagari characters present  # script check
            return self._rejected("hi", 1.0, text)  # report as Hindi and reject  # reject
        if _ARABIC.search(text):                # Arabic-script characters present  # script check
            return self._rejected("ar", 1.0, text)  # report as Arabic and reject  # reject

        code, confidence = self._get_identifier().classify(text)    # run the offline model  # classify

        # Low confidence and not clearly English -> default to English.
        if confidence < _MIN_CONFIDENCE and code != "en":   # model is unsure about a non-English guess  # uncertain
            return self._supported("en", confidence, text)  # product rule: fall back to English  # default English

        if code in SUPPORTED:                   # the detected language is one we serve  # supported
            return self._supported(code, confidence, text)  # success payload  # accept
        return self._rejected(code, confidence, text)    # detected but not served  # reject

    # Build the standard result dict for a SUPPORTED detection (supported=True, message=None).
    @staticmethod                           # no instance state is needed  # static helper
    def _supported(code: str, confidence: Optional[float], text: str) -> Dict[str, Any]:    # code + confidence + text -> result dict  # success builder
        return {                            # standard SUPPORTED result shape  # payload
            "input": text,                      # echo the text we classified  # input
            "language": SUPPORTED[code],        # English display name of the language  # language
            "code": code,                       # ISO 639-1 code  # code
            "supported": True,                  # this language is served  # supported flag
            "confidence": round(float(confidence), 4) if confidence is not None else None,  # trimmed for readability  # confidence
            "message": None,                    # no user facing message needed on success  # message
            "engine": "offline",                # produced by the py3langid engine  # engine
        }

    # Build the standard result dict for an UNSUPPORTED detection (supported=False, carrying
    # the standard NOT_SUPPORTED_MESSAGE for the caller to show the user).
    @staticmethod                           # no instance state is needed  # static helper
    def _rejected(code: str, confidence: Optional[float], text: str) -> Dict[str, Any]:    # code + confidence + text -> result dict  # reject builder
        return {                            # standard UNSUPPORTED result shape  # payload
            "input": text,                      # echo the text we classified  # input
            "language": None,                   # deliberately blank: we do not serve it  # language
            "code": code,                       # ISO 639-1 code we detected  # code
            "supported": False,                 # this language is not served  # supported flag
            "confidence": round(float(confidence), 4) if confidence is not None else None,  # trimmed for readability  # confidence
            "message": NOT_SUPPORTED_MESSAGE,   # exact wording shown to the end user  # message
            "engine": "offline",                # produced by the py3langid engine  # engine
        }


# Module-level singleton so the model is loaded once and reused across warm
# Function invocations instead of being rebuilt on every request.
_DETECTOR = LanguageDetector()                  # shared offline detector instance  # singleton


#=============================================Azure AI Foundry=====================================
# Service wrapper around the Azure AI Foundry 'multilingual-agent', powering BOTH language
# DETECTION and TRANSLATION. The agent is invoked BY NAME over the OpenAI-compatible Responses
# API, with a per-call timeout + retries so transient failures cannot hang the Function.
class FoundryAgentService:                  # LLM engine for detection AND translation  # foundry wrapper

    # config: Foundry configuration (endpoint + agent name).
    # credential: Entra ID credential from get_default_credential().
    def __init__(self, config: FoundryConfig, credential):    # builds the project + OpenAI-compatible clients  # constructor
        self.config = config                    # endpoint + agent name used by every call  # keep config
        self.project = self._build_project_client(config.endpoint, credential)  # Foundry project client  # project client
        # OpenAI-compatible client used for conversations + responses, configured with a
        # timeout + retry policy (SDK retries transient 429/5xx/timeout errors with backoff).
        raw_client = self.project.get_openai_client()   # OpenAI-compatible surface of the project  # raw client
        try:                                # not every client build exposes with_options()  # guard build
            self.openai = raw_client.with_options(      # apply the timeout + retry policy  # harden client
                timeout=FOUNDRY_TIMEOUT_SECONDS, max_retries=FOUNDRY_MAX_RETRIES    # tunables from App Settings  # policy
            )
        except Exception:  # pragma: no cover - defensive: older/looser client builds  # unsupported build
            logger.debug("openai client has no with_options(); using it without timeout/retry.")     # note the degraded path  # debug log
            self.openai = raw_client            # fall back to the unconfigured client  # plain client

    # Build the AIProjectClient with the preview Agent endpoints enabled. The Agent endpoints
    # are a preview feature, so the client is constructed with allow_preview=True; if the
    # installed build does not accept that keyword, fall back to the plain constructor.
    @staticmethod                           # no instance state is needed  # static helper
    def _build_project_client(endpoint: str, credential) -> AIProjectClient:    # endpoint + credential -> project client  # client factory
        try:                                # older builds reject the allow_preview keyword  # guard build
            return AIProjectClient(             # preferred path: preview Agent endpoints enabled  # preview client
                endpoint=endpoint, credential=credential, allow_preview=True     # project endpoint + Entra ID credential  # arguments
            )
        except TypeError:                       # older build rejects the keyword  # unsupported kwarg
            # This build does not accept the allow_preview keyword.
            return AIProjectClient(endpoint=endpoint, credential=credential)    # plain constructor  # fallback client

    # Drive the Foundry agent over the Responses API and return its reply text, or None when the
    # response did not complete. The raw message is stored as a conversation item and the steering
    # instruction (e.g. "translate into Japanese") is sent separately as this turn's `input`.
    def _run_and_get_reply(                 # one Foundry round-trip, shared by both modes  # agent call
        self, text: str, additional_instructions: Optional[str] = None   # text to act on + steering instruction  # arguments
    ) -> Optional[str]:                     # reply text, or None when unusable  # return type
        started = time.perf_counter()           # stopwatch for the upstream latency telemetry  # start timer

        # 1. Create a conversation seeded with the user's raw message.
        conversation = self.openai.conversations.create(     # new conversation per call, no shared state  # create conversation
            items=[{"type": "message", "role": "user", "content": text}]     # the user's raw message  # seed item
        )

        # 2. Run the named agent over that conversation via the Responses API.
        response = self.openai.responses.create(    # generate the agent's reply  # create response
            conversation=conversation.id,       # the conversation created above  # conversation id
            input=additional_instructions or text,  # steering instruction for this turn  # turn input
            extra_body={                        # Foundry-specific payload the SDK passes through  # extra body
                "agent_reference": {            # tells Foundry which agent to run  # agent reference
                    "name": self.config.agent_name,     # select the agent BY NAME  # agent name
                    "type": "agent_reference",  # required discriminator for the block  # type
                }
            },
        )

        elapsed_ms = round((time.perf_counter() - started) * 1000)   # upstream latency in milliseconds  # stop timer

        # 3. Guard against non-completed responses (failed / incomplete / ...).
        status = getattr(response, "status", None)   # read the status defensively  # response status
        if status and status != "completed":     # anything other than completed is unusable  # not completed
            logger.error(                       # log enough to diagnose the upstream failure  # error log
                "Foundry response did not complete (status=%s, foundry_ms=%s). Error: %s",   # message template  # template
                status, elapsed_ms, getattr(response, "error", None),    # status, latency and upstream error  # values
                extra={"foundry_ms": elapsed_ms, "foundry_status": status},  # structured fields for querying  # telemetry
            )
            return None                         # no usable reply -> the caller falls back  # give up

        # 4. Extract and return the assistant text.
        reply = self._extract_reply_text(response)  # pull the assistant text out of the result  # extract reply
        logger.info(                            # success log carrying latency and reply size  # info log
            "Foundry call completed (foundry_ms=%s, reply_len=%s).",     # message template  # template
            elapsed_ms, len(reply) if reply else 0,     # latency and reply length  # values
            extra={"foundry_ms": elapsed_ms, "reply_len": len(reply) if reply else 0},   # structured fields  # telemetry
        )
        return reply                            # agent reply, or None when it carried no text  # return reply

    # Pull the assistant's text out of a Responses API result. Prefers the SDK's `output_text`
    # convenience (it concatenates every output_text block); falls back to walking the `output`
    # items so the code stays robust if that helper is ever absent.
    @staticmethod                           # no instance state is needed  # static helper
    def _extract_reply_text(response) -> Optional[str]:    # response -> assistant text  # reply extractor
        aggregated = getattr(response, "output_text", None)     # SDK convenience property  # preferred path
        if aggregated and aggregated.strip():   # the helper gave us usable text  # got text
            return aggregated.strip()           # trimmed reply  # return reply

        # Fallback: walk the output items and collect every text block, in order.
        parts = []                              # collected text blocks, in order  # accumulator
        for item in getattr(response, "output", None) or []:    # iterate the output items safely  # walk output
            if getattr(item, "type", None) != "message":    # only assistant messages carry text  # filter type
                continue                        # skip non-message items (tool calls, etc.)  # skip
            for block in getattr(item, "content", None) or []:  # iterate the content blocks  # walk content
                value = getattr(block, "text", None)    # read the text of this block  # block text
                if value:                       # ignore empty blocks  # got text
                    parts.append(value)         # keep it for the join below  # collect
        combined = "".join(parts).strip()        # stitch the blocks back together  # join text
        return combined or None                 # blank -> None so callers can fall back  # return reply

    # Identify the language of `text` using the Foundry LLM agent, returning the SAME shape as
    # LanguageDetector.detect() (plus 'engine') so the caller need not know which engine ran.
    # Any LLM failure or unparsable reply degrades to the offline detector, never a 5xx.
    def detect_language(self, text: str) -> Dict[str, Any]:    # confidence is None on the LLM path  # LLM detect
        text = (text or "").strip()             # normalise None and surrounding whitespace  # normalise input
        if not text:                            # empty input carries no language  # nothing to detect
            result = LanguageDetector._supported("en", None, text)  # nothing to detect  # default English
            result["engine"] = "rule"           # produced without an LLM call  # engine tag
            return result                       # early return, no upstream call  # respond

        # Fast, deterministic rejects for scripts no supported language uses.
        # These save an LLM round-trip and can never be misread.
        if _DEVANAGARI.search(text):            # Devanagari characters present  # script check
            result = LanguageDetector._rejected("hi", None, text)   # report as Hindi and reject  # reject
            result["engine"] = "rule"           # produced without an LLM call  # engine tag
            return result                       # early return, no upstream call  # respond
        if _ARABIC.search(text):                # Arabic-script characters present  # script check
            result = LanguageDetector._rejected("ar", None, text)   # report as Arabic and reject  # reject
            result["engine"] = "rule"           # produced without an LLM call  # engine tag
            return result                       # early return, no upstream call  # respond

        try:                                # any upstream failure degrades to the offline engine  # guard call
            code = self._detect_code_via_agent(text)    # ask the LLM for an ISO 639-1 code  # call agent
        except Exception:                       # any Foundry-side failure  # upstream error
            # Any Foundry-side failure degrades to the offline engine, never a 5xx.
            logger.exception("LLM language detection failed; using offline detector.")   # full stack for ops  # error log
            return _DETECTOR.detect(text)       # offline result keeps the endpoint up  # fallback

        if not code:                            # the reply could not be parsed  # unusable reply
            # Reply could not be parsed into a code -> fall back rather than guess.
            logger.warning("Could not read a language code from the LLM; using offline detector.")   # note the fallback  # warn
            return _DETECTOR.detect(text)       # offline result rather than a guess  # fallback

        code = LANG_ALIASES.get(code, code)     # normalise aliases (jp -> ja, ...)  # apply aliases
        if code in SUPPORTED:                   # the detected language is one we serve  # supported
            result = LanguageDetector._supported(code, None, text)  # success payload  # accept
        else:                                   # detected but not served  # unsupported
            result = LanguageDetector._rejected(code, None, text)   # reject payload  # reject
        result["engine"] = "foundry"            # produced by the LLM engine  # engine tag
        return result                           # same shape as the offline detector  # respond

    # Ask the agent to name the language and return its ISO 639-1 code, or None when the reply
    # was unusable.
    def _detect_code_via_agent(self, text: str) -> Optional[str]:    # text: the message whose language we want  # code via LLM
        reply = self._run_and_get_reply(        # single Foundry round-trip  # call agent
            text,                               # the message whose language we want  # input text
            additional_instructions=(           # keep the instruction narrow so parsing is trivial  # steering
                "Identify the language of the user's message. Respond with ONLY the "   # the task  # line 1
                "ISO 639-1 two-letter language code (for example: en, ja, hi, fr, fi). "     # required output format  # line 2
                "Do not add any other words, punctuation, or explanation."   # no prose, so parsing stays simple  # line 3
            ),
        )
        return self._parse_language_code(reply)     # turn the free-text reply into a code  # parse reply

    # Best-effort extraction of a language code from the agent's free-text reply. A single-token
    # reply is trusted; a code buried in a sentence is NOT (codes like 'hi', 'he', 'it', 'id' are
    # also common English words), so multi-word replies only match an unambiguous display NAME.
    @staticmethod                           # no instance state is needed  # static helper
    def _parse_language_code(reply: Optional[str]) -> Optional[str]:    # reply: the agent's free-text answer  # reply parser
        if not reply:                           # nothing came back from the agent  # empty reply
            return None                         # caller falls back to the offline detector  # give up
        cleaned = re.sub(r"[^a-z\s]", " ", reply.strip().lower()).strip()    # strip punctuation/case  # normalise reply
        if not cleaned:                         # reply held no letters at all  # nothing usable
            return None                         # caller falls back to the offline detector  # give up
        words = cleaned.split()                 # tokenise so we can spot a single-token reply  # tokenise
        known_codes = set(SUPPORTED) | set(DECOYS) | set(LANG_ALIASES)   # every code we recognise  # known codes

        # 1. The instructed happy path: the reply IS just the code (single token).
        if len(words) == 1:                     # exactly what the agent was told to return  # single token
            token = words[0]                    # the candidate code  # candidate
            if token in known_codes:            # a code we already track  # known code
                return token                    # trusted match  # return code
            if len(token) == 2 and token.isalpha():     # looks like an ISO 639-1 code  # code shaped
                return token  # a valid-looking code we do not otherwise track (e.g. 'fi')  # return code

        # 2. A supported language display NAME appearing anywhere ('...is Japanese').
        #    Names are unambiguous, so this is safe even inside a sentence.
        for code, name in SUPPORTED.items():    # walk the supported languages  # name match
            if name.lower() in cleaned:         # the display name appears in the reply  # found name
                return code                     # map the name back to its code  # return code

        # 3. Give up -> the caller falls back to the offline detector.
        return None                             # nothing usable was found  # give up

    # Translate `text` into `target_language` using the Foundry agent. The agent is instructed
    # to return ONLY the translation so the reply can be used verbatim. Returns the translated
    # text, or None if nothing was produced.
    def translate_message(self, text: str, target_language: str) -> Optional[str]:    # text + target language -> translated text  # LLM translate
        logger.info("Translating message into %s via Foundry agent.", target_language,   # note the target language  # info log
                    extra={"target_language": target_language})     # structured field for querying  # telemetry
        reply = self._run_and_get_reply(        # single Foundry round-trip  # call agent
            text,                               # the message to translate  # input text
            additional_instructions=(           # ONLY the translation, so the reply is usable as-is  # steering
                f"Translate the user's message into {target_language}. "     # the task and the target  # line 1
                f"Return ONLY the translated text, with no explanations, notes, "    # required output format  # line 2
                f"or the original message."     # no echo of the source text  # line 3
            ),
        )
        if not reply:                           # upstream gave us nothing usable  # empty reply
            # Upstream returned nothing usable; the caller turns this into a 502.
            logger.warning("Foundry multilingual agent did not return any text.")    # note the failure  # warn
        return reply                            # translated text, or None on failure  # return reply


#=====================================Cached Foundry service=======================================
# The Foundry client + credential are relatively expensive to build (token acquisition, HTTP
# session). Build ONCE per worker and reuse across requests; rebuild only if the endpoint/agent
# configuration changes. Guarded by a lock for the concurrent Python worker.
_service_lock = threading.Lock()                # guards the one-time service build  # build lock
_foundry_service: Optional[FoundryAgentService] = None      # cached service instance  # cache slot
_foundry_service_key: Optional[tuple] = None    # config the cached instance was built from  # cache key


# Return a cached FoundryAgentService, (re)building it only when config changes. Building the
# client per request would add token acquisition + TLS setup to every call; caching keeps warm
# invocations fast without pinning stale configuration.
def get_foundry_service(foundry_cfg: FoundryConfig) -> FoundryAgentService:    # foundry_cfg: the config the service must match  # cached accessor
    global _foundry_service, _foundry_service_key   # the module-level cache is rebound here  # globals
    key = (foundry_cfg.endpoint, foundry_cfg.agent_name)    # identity of the current config  # cache key

    # Cheap read first: a valid cache is reused without taking the lock.
    service = _foundry_service                  # single read, safe against concurrent rebinding  # snapshot
    if service is not None and _foundry_service_key == key:     # cache is present and still valid  # cache hit
        return service                          # warm path, no lock taken  # reuse service
    with _service_lock:                         # serialise concurrent first calls  # take lock
        if _foundry_service is None or _foundry_service_key != key:  # re-test inside the lock  # double check
            logger.info("Building Foundry service client (first use or config change).")     # note the cold build  # info log
            credential = get_default_credential()   # managed identity in Azure  # credential
            _foundry_service = FoundryAgentService(foundry_cfg, credential)  # build the service once  # build service
            _foundry_service_key = key          # remember the config it was built from  # store key
        return _foundry_service                 # freshly built or built by another thread  # return service


#==============================================Azure Function Entry================================
def main(req: func.HttpRequest) -> func.HttpResponse:
    """
    HTTP-triggered Azure Function entry point.

    Responsibilities:
    - Validate and parse the incoming request [query string OR JSON body].
    - Route the request by the 'agent' field:
        'detect'    -> detect the language (Foundry LLM; offline fallback) and return it.
        'translate' -> translate 'message' into the target 'lang' via Foundry.
    - Load configuration and authenticate using managed identity.
    - Emit structured telemetry (latency, engine, sizes) and return a JSON response.

    Why:
    - This function is the single entry point for the multilingual experience, so it
      centralises input validation, correlation and telemetry while avoiding embedded
      secrets and never leaking internal exception detail to the caller.

    Returns:
    - func.HttpResponse with a JSON body carrying the correlation_id on EVERY path.
      HTTP status codes:
        200 - success (detect or translate).
        400 - input error (missing message / mode, oversized input, unsupported lang).
        502 - upstream Foundry produced no usable result (translate).
        500 - unhandled server error.
    """
    # Correlate every log line for this request; honour a (validated) caller-supplied id.
    correlation_id = sanitize_correlation_id(req.headers.get("x-correlation-id"))    # caller id or a fresh UUID  # correlation id
    _correlation_id_var.set(correlation_id)     # publish it so the log filter picks it up  # context var
    request_started = time.perf_counter()       # stopwatch for the end-to-end latency telemetry  # start timer
    logger.info("Request received for Multilingual Agent function.",     # entry log for every request  # entry log
                extra={"correlation_id": correlation_id})   # structured field for querying  # telemetry

    # Top-level guard: any unexpected error becomes a 500 instead of a leaked stack trace.
    try:                                    # guard for unexpected exceptions  # safety net
        # 1. Parse the JSON body once and work out which mode was requested.
        body = get_json_body(req)               # {} when the body is absent or invalid  # read body
        agent_mode = extract_agent(req, body)   # 'detect' | 'translate' | None  # read mode

        # 2. Read the user message [required for both modes] and bound its size.
        user_message = extract_message(req, body)   # query string or body, aliases accepted  # read message
        if not user_message or not str(user_message).strip():    # missing or blank message  # validate presence
            return error_response(              # 400 so the client can correct the payload  # respond bad request
                "Input Error.",                 # short, stable message for the client  # message
                "message is required [query string or JSON body].",  # says exactly what was missing  # details
                400, correlation_id,            # status plus the trace id  # status + trace
            )
        user_message = str(user_message)        # normalise to str for the length check below  # coerce type
        if len(user_message) > MAX_MESSAGE_CHARS:    # oversized input bounds cost / abuse  # validate size
            return error_response(              # 400 so the client can shorten the input  # respond bad request
                "Input Error.",                 # short, stable message for the client  # message
                f"message exceeds the maximum length of {MAX_MESSAGE_CHARS} characters.",    # states the limit  # details
                400, correlation_id,            # status plus the trace id  # status + trace
            )

        # 3a. DETECT mode -> identify the language with the Foundry LLM agent.
        #     Falls back to the offline py3langid detector if Foundry is unavailable,
        #     so this endpoint stays up even when the LLM cannot be reached.
        if agent_mode == "detect":              # caller asked only for the language  # detect mode
            try:                            # Foundry path, with the offline fallback below  # guard call
                config = load_config()          # endpoint, agent name and environment  # load config
                foundry_service = get_foundry_service(config.foundry)    # cached service instance  # get service
                detection = foundry_service.detect_language(user_message)    # LLM based detection  # detect
            except Exception:                   # config or Foundry side failure  # any error
                logger.exception("Foundry detection unavailable; using offline detector.")    # full stack for ops  # error log
                detection = _DETECTOR.detect(user_message)   # offline result keeps the endpoint up  # fallback

            # Structured completion log so engine / outcome / latency stay queryable.
            logger.info(                        # one completion log per detect request  # info log
                "detect complete.",             # stable message text for querying  # message
                extra={                         # structured fields, not string-formatted  # telemetry
                    "agent": "detect",          # which mode served the request  # mode
                    "engine": detection.get("engine"),      # 'foundry' | 'offline' | 'rule'  # engine
                    "code": detection.get("code"),  # detected ISO 639-1 code  # code
                    "supported": detection.get("supported"),    # whether we serve that language  # supported flag
                    "msg_len": len(user_message),   # input size for cost analysis  # message length
                    "total_ms": round((time.perf_counter() - request_started) * 1000),   # end-to-end latency  # latency
                },
            )
            return json_response(               # 200 with the detection result  # success response
                {                           # detect success body  # payload
                    "Success": True,            # indicate success to the caller  # result
                    "agent": "detect",          # echo which mode ran  # mode
                    "supported": detection["supported"],    # whether we serve that language  # supported flag
                    "language": detection["language"],      # null when unsupported  # language
                    "code": detection["code"],  # detected ISO 639-1 code  # code
                    "confidence": detection["confidence"],   # null on the LLM path  # confidence
                    "engine": detection.get("engine"),  # which engine produced the answer  # engine
                    "correlation_id": correlation_id,   # trace id on every response  # trace id
                    "message": detection["message"],        # populated only when unsupported  # message
                }
            )

        # 3b. TRANSLATE mode -> translate the message into the requested language.
        if agent_mode == "translate":           # caller asked for a translation  # translate mode
            target_language = resolve_language(extract_lang(req, body))   # token -> supported display name  # resolve lang
            if not target_language:             # missing or unsupported target language  # validate lang
                return error_response(          # 400 listing the supported languages  # respond bad request
                    "Input Error.",             # short, stable message for the client  # message
                    "'lang' is required for translate and must be a supported language. "    # says what is wrong  # details
                    + NOT_SUPPORTED_MESSAGE,    # append the agreed list of supported languages  # supported list
                    400, correlation_id,        # status plus the trace id  # status + trace
                )

            # Load configuration + cached service, then call the Foundry agent.
            config = load_config()              # endpoint, agent name and environment  # load config
            foundry_service = get_foundry_service(config.foundry)    # cached service instance  # get service
            reply = foundry_service.translate_message(user_message, target_language)     # translate via Foundry  # translate

            if not reply:                       # upstream produced nothing usable  # empty reply
                # Upstream produced nothing usable -> tell the caller to retry (502).
                return error_response(          # 502 marks this as an upstream failure  # respond bad gateway
                    "Translation failed.",      # short, stable message for the client  # message
                    "The translation service did not return a result. Please retry.",    # actionable advice  # details
                    502, correlation_id,        # status plus the trace id  # status + trace
                )

            # Structured completion log so latency and payload sizes stay queryable.
            logger.info(                        # one completion log per translate request  # info log
                "translate complete.",          # stable message text for querying  # message
                extra={                         # structured fields, not string-formatted  # telemetry
                    "agent": "translate",       # which mode served the request  # mode
                    "target_language": target_language,     # language we translated into  # target
                    "msg_len": len(user_message),   # input size for cost analysis  # message length
                    "reply_len": len(reply),    # output size for cost analysis  # reply length
                    "total_ms": round((time.perf_counter() - request_started) * 1000),   # end-to-end latency  # latency
                },
            )
            return json_response(               # 200 with the translated text  # success response
                {                           # translate success body  # payload
                    "Success": True,            # indicate success to the caller  # result
                    "agent": "translate",       # echo which mode ran  # mode
                    "language": target_language,    # language we translated into  # target
                    "environment": config.environment,  # environment string used by the function  # env
                    "correlation_id": correlation_id,   # trace id on every response  # trace id
                    "reply": reply,             # the translated text, usable as-is  # translation
                }
            )

        # 4. Missing / unknown agent -> tell the caller the valid options.
        return error_response(                  # 400 because the mode is part of the contract  # respond bad request
            "Input Error.",                     # short, stable message for the client  # message
            "agent is required and must be 'detect' or 'translate'.",     # lists the valid options  # details
            400, correlation_id,                # status plus the trace id  # status + trace
        )

    except Exception:                           # catch-all so no stack trace ever reaches a client  # safety net
        # Final safeguard: log the full stack trace server-side, but NEVER leak internal
        # exception detail to the caller. The correlation_id lets support find the log.
        logger.exception("Unhandled exception in Multilingual Agent function.")  # full stack for operators  # error log
        return error_response(                  # 500 indicates a server-side fault  # server error response
            "Unhandled server error. Please contact the automation team.",    # what the user should do  # message
            f"An unexpected error occurred. Quote correlation_id '{correlation_id}' to support.",     # no internal detail  # details
            500, correlation_id,                # status plus the trace id  # status + trace
        )
