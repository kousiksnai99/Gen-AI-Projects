# Generation tunables. These are latency controls as much as cost controls.
#
# IMPORTANT - the default deployment is a REASONING model (gpt-5-mini), which changes the
# parameter contract versus the gpt-4o family:
#   - it takes `max_completion_tokens`, NOT `max_tokens`;
#   - it rejects any `temperature` other than the default, so we do not send one;
#   - `reasoning_effort` is supported, and 'minimal' is the right setting here because both
#     modes are short, mechanical tasks - reasoning tokens would be pure added latency;
#   - reasoning tokens are billed against `max_completion_tokens`. That is why the detect cap
#     below is 512 and not 8: an 8-token budget can be consumed entirely by reasoning, which
#     returns an EMPTY reply with finish_reason='length'. These caps are ceilings, not
#     targets - a generous ceiling costs nothing when it is not reached.
LLM_PARAM_STYLE = os.getenv("LLM_PARAM_STYLE", "reasoning").strip().lower()   # 'reasoning' (gpt-5) | 'legacy' (gpt-4o)  # param style
LLM_REASONING_EFFORT = os.getenv("LLM_REASONING_EFFORT", "minimal").strip()   # minimal|low|medium|high; '' omits the field  # reasoning effort
LLM_TEMPERATURE = _float_env("LLM_TEMPERATURE", 0.0)        # legacy style only: 0 = deterministic  # temperature
DETECT_MAX_TOKENS = _int_env("DETECT_MAX_TOKENS", 512)      # headroom for reasoning tokens + a 2-letter answer  # detect cap
TRANSLATE_MAX_TOKENS = _int_env("TRANSLATE_MAX_TOKENS", 8192)    # headroom for reasoning + a full non-Latin translation  # translate cap
DETECT_SAMPLE_CHARS = _int_env("DETECT_SAMPLE_CHARS", 400)   # language is identifiable from the opening; sending 5000 chars is waste  # detect sample


