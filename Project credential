# Detection deliberately does NOT use AGENT_SYSTEM_PROMPT. The persona above is told to answer
# in the user's own language and in whole sentences, which directly fights "reply with only an
# ISO code" and would break _parse_language_code. A narrow classifier prompt is also far fewer
# input tokens, which is part of the latency saving.
DETECT_SYSTEM_PROMPT = (
    "You are a language identification engine. "
    "Identify the language of the user's message and reply with ONLY the ISO 639-1 "
    "two-letter language code (for example: en, ja, hi, fr, fi). "
    "Do not add any other words, punctuation, or explanation."
)


def build_translate_system_prompt(target_language: str) -> str:
    """
    Build the translate system prompt: the agent persona plus a task block that overrides its
    response-style rules for this call.

    The persona is kept so tone/behaviour stay identical to the previously deployed agent; the
    override is what keeps the reply usable verbatim as a translation.
    """
    return (
        AGENT_SYSTEM_PROMPT
        + "\n\nCURRENT TASK [overrides the RESPONSE LENGTH and STYLE rules above]\n"
        + f"- Translate the user's message into {target_language}\n"
        + "- Return ONLY the translated text\n"
        + "- No explanations, no notes, no echo of the original message\n"
        + "- Keep names, IDs, URLs, codes and formatting exactly as they appear"
    )


#=============================================Azure OpenAI (direct)================================
# The two generation-parameter dialects. gpt-5 / o-series deployments take the 'reasoning' set;
# the gpt-4o family takes the 'legacy' set and rejects the reasoning one. LLM_PARAM_STYLE picks
# the starting dialect and _chat() flips to the other ONCE if the deployment refuses it, so
# swapping the deployment to a different model family does not require a code change.
_STYLE_REASONING = "reasoning"
_STYLE_LEGACY = "legacy"

# Markers seen in the error body when a deployment rejects a generation parameter.
_UNSUPPORTED_PARAM_MARKERS = (
    "unsupported_parameter",
    "unsupported parameter",
    "unsupported_value",
    "unsupported value",
    "max_completion_tokens",
    "'max_tokens'",
    "'temperature'",
    "reasoning_effort",
)


def _is_unsupported_parameter_error(exc: Exception) -> bool:
    """
    True when `exc` looks like "this deployment does not accept that generation parameter".

    Kept narrow on purpose: anything else must propagate so the normal fallbacks still fire.
    """
    text = str(exc).lower()
    return any(marker in text for marker in _UNSUPPORTED_PARAM_MARKERS)


def _upstream_status(exc: Exception) -> Optional[int]:
    """Upstream HTTP status carried by an SDK exception, or None when it never reached the wire."""
    return getattr(exc, "status_code", None) or getattr(
        getattr(exc, "response", None), "status_code", None
    )


def _upstream_error_code(exc: Exception) -> Optional[str]:
    """
    Azure OpenAI's machine-readable error `code` (e.g. 'DeploymentNotFound', 'content_filter').

    Read from several shapes because the SDK surfaces it inconsistently across versions. Codes
    are identifiers, not messages, so they are safe to return to a caller.
    """
    code = getattr(exc, "code", None)
    if isinstance(code, str) and code:
        return code
    body = getattr(exc, "body", None)
    if isinstance(body, dict):
        inner = body.get("error")
        if isinstance(inner, dict) and isinstance(inner.get("code"), str):
            return inner["code"]
        if isinstance(body.get("code"), str):
            return body["code"]
    return None


def upstream_hint(exc: Exception) -> str:
    """
    Build a SHORT, non-sensitive hint describing an upstream failure, safe to return to callers.

    Only the exception class, the upstream HTTP status and Azure's error `code` are exposed —
    never the message body, which could carry internal detail. That trio is what makes a 502
    actionable instead of opaque:

        404 / DeploymentNotFound -> AZURE_OPENAI_DEPLOYMENT does not exist on the resource
        401 / 403                -> the managed identity lacks 'Cognitive Services OpenAI User'
        400 + a parameter name   -> the deployment rejects that generation parameter
        429                      -> rate limited / quota exhausted
        no status at all         -> DNS, TLS or timeout; the endpoint was never reached
    """
    parts = [type(exc).__name__]
    status = _upstream_status(exc)
    if status:
        parts.append(f"status={status}")
    code = _upstream_error_code(exc)
    if code:
        parts.append(f"code={code}")
    return " ".join(parts)


class _EntraIdOpenAI(OpenAI):
    """
    The plain OpenAI client with the Entra ID token supplied per request.

    Why NOT openai.AzureOpenAI: on the /openai/v1 surface, AzureOpenAI._build_request rewrites
    the path to '/openai/v1/deployments/<model>/chat/completions', which is the LEGACY Azure
    route and 404s against v1. The plain client performs no path rewriting, so the endpoint
    from App Settings is used exactly as configured — and the behaviour is identical on
    openai 1.x and 2.x.

    `auth_headers` is re-read by the SDK on EVERY request, which is what keeps the token fresh:
    get_bearer_token_provider caches internally and only re-fetches near expiry, so this is a
    dictionary lookup on the warm path rather than a token call.

    NOTE: this client is not copy()/with_options()-able, because those rebuild it without
    token_provider. Nothing here needs them — the timeout/retry policy is set at construction.
    """

    def __init__(self, *, token_provider, **kwargs):
        self._token_provider = token_provider
        # A placeholder api_key satisfies the base constructor; auth_headers below is what ships.
        super().__init__(api_key="managed-identity", **kwargs)

    @property
    def auth_headers(self) -> Dict[str, str]:
        return {"Authorization": f"Bearer {self._token_provider()}"}


class FoundryAgentService:
    """
    Service wrapper around the Azure OpenAI model, powering BOTH detection and translation.

    The model is called DIRECTLY over Chat Completions: ONE round-trip per request, no agent
    name resolution and no conversation object. The instruction travels as the `system` message
    and the caller's text as the `user` message, so data and instruction never blur together.

    A per-call timeout and automatic retries are applied so transient failures do not hang the
    Function or fail the request unnecessarily.
    """

    def __init__(self, config: FoundryConfig, credential):
        """
        Args:
            config:     Model configuration (endpoints + deployment + api-version + auth mode).
            credential: Entra ID credential from get_default_credential().
        """
        self.config = config
        self.openai = self._build_client(config, credential)
        # Starting dialect; flipped ONCE in _chat() if the deployment rejects it.
        self._param_style = (
            _STYLE_LEGACY if LLM_PARAM_STYLE == _STYLE_LEGACY else _STYLE_REASONING
        )

    @staticmethod
    def _build_client(config: FoundryConfig, credential):
        """
        Build the OpenAI-compatible client for the configured auth mode.

        All three modes end up calling chat.completions directly, so the one-round-trip saving
        is identical. They differ ONLY in which endpoint is used and which Azure permission is
        required — see LLM_AUTH_MODE for why that matters.
        """
        # 1. API key wins when supplied: no Entra token, no RBAC, straight at the data plane.
        if AZURE_OPENAI_API_KEY:
            logger.info("Building Azure OpenAI client with API key auth.")
            return OpenAI(
                api_key=AZURE_OPENAI_API_KEY,
                base_url=config.openai_endpoint,
                default_query=(
                    {"api-version": config.api_version} if config.api_version else None
                ),
                timeout=FOUNDRY_TIMEOUT_SECONDS,
                max_retries=FOUNDRY_MAX_RETRIES,
            )

        # 2. DEFAULT — go through the Foundry project, exactly as the named-agent path did.
        #    Same endpoint, same token audience, so the EXISTING role assignment is sufficient
        #    and no cloud permission change is needed to adopt the direct-call optimisation.
        if config.auth_mode == "project":
            logger.info("Building Azure OpenAI client via the Foundry project endpoint "
                        "(project auth; no new role assignment required).")
            from azure.ai.projects import AIProjectClient  # imported lazily: only this mode needs it

            try:
                project = AIProjectClient(
                    endpoint=config.project_endpoint, credential=credential, allow_preview=True
                )
            except TypeError:
                # Older builds do not accept allow_preview.
                project = AIProjectClient(endpoint=config.project_endpoint, credential=credential)

            # get_openai_client() builds an AzureOpenAI internally and REQUIRES an api-version;
            # omitting it raises ValueError. azure-ai-projects 2.x accepts 'preview'; older 1.x
            # builds want a dated value such as '2024-10-21' — set AZURE_OPENAI_API_VERSION if so.
            try:
                raw = project.get_openai_client(api_version=config.api_version)
            except TypeError:
                # This build does not accept the api_version keyword.
                raw = project.get_openai_client()

            try:
                # Apply the same timeout/retry policy the other modes set at construction.
                return raw.with_options(
                    timeout=FOUNDRY_TIMEOUT_SECONDS, max_retries=FOUNDRY_MAX_RETRIES
                )
            except Exception:  # pragma: no cover - defensive: older/looser client builds
                logger.debug("Project OpenAI client has no with_options(); using it as-is.")
                return raw

        # 3. Direct data-plane call. Needs 'Cognitive Services OpenAI User' on the resource.
        logger.info("Building Azure OpenAI client against the data plane (direct auth).")
        return _EntraIdOpenAI(
            token_provider=get_bearer_token_provider(credential, AZURE_OPENAI_SCOPE),
            base_url=config.openai_endpoint,
            default_query=(
                {"api-version": config.api_version} if config.api_version else None
            ),
            timeout=FOUNDRY_TIMEOUT_SECONDS,
            max_retries=FOUNDRY_MAX_RETRIES,
        )

    def _generation_params(self, max_tokens: int) -> Dict[str, Any]:
        """
        Build the generation parameters for the current dialect.

        Separated from _chat() so the retry path can simply rebuild them after flipping style,
        rather than patching keys in place. Note there is NO temperature on the reasoning
        dialect: those deployments accept only the default and return 400 otherwise.
        """
        if self._param_style == _STYLE_REASONING:
            params: Dict[str, Any] = {"max_completion_tokens": max_tokens}
            if LLM_REASONING_EFFORT:
                params["reasoning_effort"] = LLM_REASONING_EFFORT
            return params
        return {"max_tokens": max_tokens, "temperature": LLM_TEMPERATURE}

    def _chat(self, system_prompt: str, user_text: str, max_tokens: int) -> Optional[str]:
        """
        Issue ONE Chat Completions call and return the assistant text.

        This is the single upstream hop shared by both modes — it replaces the old
        conversations.create() + responses.create() pair.

        Returns:
            Optional[str]: The assistant's reply text, or None if nothing usable came back.
        """
        started = time.perf_counter()
        base: Dict[str, Any] = {
            "model": self.config.deployment,   # on Azure, `model` IS the deployment name
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": user_text},
            ],
        }

        try:
            response = self.openai.chat.completions.create(
                **base, **self._generation_params(max_tokens)
            )
        except Exception as exc:
            if not _is_unsupported_parameter_error(exc):
                raise   # let the caller's fallback / 502 handling deal with it
            # The deployment belongs to the other model family. Flip dialect and remember it for
            # the life of the worker, so only the first call ever pays for this extra round-trip.
            flipped = (
                _STYLE_LEGACY if self._param_style == _STYLE_REASONING else _STYLE_REASONING
            )
            logger.warning("Deployment '%s' rejected the '%s' parameters; switching to '%s'.",
                           self.config.deployment, self._param_style, flipped)
            self._param_style = flipped
            response = self.openai.chat.completions.create(
                **base, **self._generation_params(max_tokens)
            )

        elapsed_ms = round((time.perf_counter() - started) * 1000)
        reply = self._extract_reply_text(response)
        finish_reason = self._extract_finish_reason(response)

        if finish_reason == "length":
            if not reply:
                # On a reasoning deployment this means the whole budget went on reasoning tokens
                # before any answer was emitted. The fix is a bigger ceiling or a lower
                # LLM_REASONING_EFFORT — NOT a prompt change.
                logger.error(
                    "Empty reply: the %s-token budget was consumed before any output "
                    "(reasoning_effort=%s). Raise the ceiling or lower the effort.",
                    max_tokens, LLM_REASONING_EFFORT or "default",
                    extra={"finish_reason": finish_reason, "max_tokens": max_tokens},
                )
            else:
                # Surfaced rather than hidden: a truncated translation is a wrong translation.
                logger.warning("Reply hit the %s-token output ceiling; it may be truncated.",
                               max_tokens, extra={"finish_reason": finish_reason})

        logger.info(
            "LLM call completed (foundry_ms=%s, reply_len=%s, finish_reason=%s).",
            elapsed_ms, len(reply) if reply else 0, finish_reason,
            extra={
                "foundry_ms": elapsed_ms,       # field name kept so existing queries still work
                "reply_len": len(reply) if reply else 0,
                "deployment": self.config.deployment,
                "finish_reason": finish_reason,
            },
        )
        return reply

    @staticmethod
    def _extract_reply_text(response) -> Optional[str]:
        """
        Pull the assistant's text out of a Chat Completions result.

        The plain `.content` string is the normal case; the block-list branch keeps the code
        working on SDK builds (and models) that return typed content parts instead.
        """
        for choice in getattr(response, "choices", None) or []:
            content = getattr(getattr(choice, "message", None), "content", None)
            if isinstance(content, str):
                if content.strip():
                    return content.strip()
                continue
            parts = []
            for block in content or []:
                value = getattr(block, "text", None)
                if value is None and isinstance(block, dict):
                    value = block.get("text")
                if value:
                    parts.append(value)
            combined = "".join(parts).strip()
            if combined:
                return combined
        return None

    @staticmethod
    def _extract_finish_reason(response) -> Optional[str]:
        """Why generation stopped ('stop' | 'length' | 'content_filter' | ...), for telemetry."""
        for choice in getattr(response, "choices", None) or []:
            return getattr(choice, "finish_reason", None)
        return None

    def detect_language(self, text: str) -> Dict[str, Any]:
        """
        Identify the language of `text` using the LLM.

        Returns the SAME result shape as LanguageDetector.detect() (plus an
        'engine' field) so the caller does not care which engine produced it:
            input, language, code, supported, confidence, message, engine.

        Robustness:
            * Devanagari / Arabic script -> instant deterministic reject (no LLM call).
            * If the LLM call fails, or its reply cannot be parsed into a language
              code, fall back to the offline py3langid detector so 'detect' never
              goes down.

        The LLM does not return a numeric confidence, so `confidence` is None on
        the LLM path.
        """
        text = (text or "").strip()
        if not text:
            result = LanguageDetector._supported("en", None, text)  # nothing to detect
            result["engine"] = "rule"
            return result

        # Fast, deterministic rejects for scripts no supported language uses.
        # These save an LLM round-trip and can never be misread.
        if _DEVANAGARI.search(text):
            result = LanguageDetector._rejected("hi", None, text)
            result["engine"] = "rule"
            return result
        if _ARABIC.search(text):
            result = LanguageDetector._rejected("ar", None, text)
            result["engine"] = "rule"
            return result

        try:
            code = self._detect_code_via_llm(text)
        except Exception:
            logger.exception("LLM language detection failed; using offline detector.")
            return _DETECTOR.detect(text)

        if not code:
            logger.warning("Could not read a language code from the LLM; using offline detector.")
            return _DETECTOR.detect(text)

        code = LANG_ALIASES.get(code, code)  # normalise aliases (jp -> ja, ...)
        if code in SUPPORTED:
            result = LanguageDetector._supported(code, None, text)
        else:
            result = LanguageDetector._rejected(code, None, text)
        result["engine"] = "foundry"
        return result

    def _detect_code_via_llm(self, text: str) -> Optional[str]:
        """
        Ask the model to name the language and return its ISO 639-1 code (or None).

        Only the opening DETECT_SAMPLE_CHARS characters are sent: a language is identifiable
        from the first sentence, so shipping a 5000-character message would be paying prompt
        tokens and prefill latency for nothing.
        """
        reply = self._chat(
            DETECT_SYSTEM_PROMPT,
            text[:DETECT_SAMPLE_CHARS],
            DETECT_MAX_TOKENS,
        )
        return self._parse_language_code(reply)

    @staticmethod
    def _parse_language_code(reply: Optional[str]) -> Optional[str]:
        """
        Best-effort extraction of a language code from the model's free-text reply.

        The model is instructed to return ONLY the two-letter code, so the happy path is a
        single-token reply. To avoid confidently-wrong matches, a code buried in a longer
        sentence is NOT trusted (many ISO codes — 'hi', 'he', 'it', 'id' — are also common
        English words that would collide); for multi-word replies we only trust an unambiguous
        language display NAME. Returns None when nothing usable is found so the caller can
        fall back to the offline detector.
        """
        if not reply:
            return None
        cleaned = re.sub(r"[^a-z\s]", " ", reply.strip().lower()).strip()
        if not cleaned:
            return None
        words = cleaned.split()
        known_codes = set(SUPPORTED) | set(DECOYS) | set(LANG_ALIASES)

        # 1. The instructed happy path: the reply IS just the code (single token).
        if len(words) == 1:
            token = words[0]
            if token in known_codes:
                return token
            if len(token) == 2 and token.isalpha():
                return token  # a valid-looking code we do not otherwise track (e.g. 'fi')

        # 2. A supported language display NAME appearing anywhere ('...is Japanese').
        #    Names are unambiguous, so this is safe even inside a sentence.
        for code, name in SUPPORTED.items():
            if name.lower() in cleaned:
                return code

        # 3. Give up -> the caller falls back to the offline detector.
        return None

    def translate_message(self, text: str, target_language: str) -> Optional[str]:
        """
        Translate `text` into `target_language` using the model.

        The system prompt carries the agent persona plus a task block instructing it to return
        ONLY the translation, so the reply can be used verbatim. Returns the translated text,
        or None if nothing was produced.
        """
        logger.info("Translating message into %s via Azure OpenAI.", target_language,
                    extra={"target_language": target_language})
        reply = self._chat(
            build_translate_system_prompt(target_language),
            text,
            TRANSLATE_MAX_TOKENS,
        )
        if not reply:
            logger.warning("Azure OpenAI did not return any translated text.")
        return reply


#=====================================Cached LLM service===========================================
# The client + credential are relatively expensive to build (token acquisition, HTTP session).
# Build ONCE per worker and reuse across requests; rebuild only if the configuration changes.
# The service and its cache key live in ONE tuple so a warm reader can never see a service
# paired with someone else's key (rebinding one name is atomic, rebinding two is not).
_service_lock = threading.Lock()
_foundry_service_cache: Optional[tuple] = None


def get_foundry_service(foundry_cfg: FoundryConfig) -> FoundryAgentService:
    """Return a cached FoundryAgentService, (re)building it only when config changes."""
    global _foundry_service_cache
    key = (foundry_cfg.auth_mode, foundry_cfg.openai_endpoint, foundry_cfg.project_endpoint,
           foundry_cfg.deployment, foundry_cfg.api_version, bool(AZURE_OPENAI_API_KEY))

    cached = _foundry_service_cache
    if cached is not None and cached[0] == key:
        return cached[1]
    with _service_lock:
        cached = _foundry_service_cache
        if cached is None or cached[0] != key:
            logger.info("Building Azure OpenAI client (first use or config change).")
            credential = get_default_credential()
            cached = (key, FoundryAgentService(foundry_cfg, credential))
            _foundry_service_cache = cached
        return cached[1]


#==============================================Azure Function Entry================================
def main(req: func.HttpRequest) -> func.HttpResponse:
    """
    HTTP-triggered Azure Function entry point.

    Routes the request by the 'agent' field:
        'detect'    -> detect the language (direct LLM call; offline fallback) and return it.
        'translate' -> translate 'message' into the target 'lang' via a direct LLM call.

    Every path returns a structured JSON response carrying the correlation_id.
    HTTP status codes:
        200 - success (detect or translate).
        400 - input error (missing message / mode, oversized input, unsupported lang).
        502 - the upstream model produced no usable result (translate).
        500 - unhandled server error.
    """
    # Correlate every log line for this request; honour a (validated) caller-supplied id.
    correlation_id = sanitize_correlation_id(req.headers.get("x-correlation-id"))
    _correlation_id_var.set(correlation_id)
    request_started = time.perf_counter()
    logger.info("Request received for Multilingual Agent function.",
                extra={"correlation_id": correlation_id})

    try:
        # 1. Parse the JSON body once and work out which mode was requested.
        body = get_json_body(req)
        agent_mode = extract_agent(req, body)

        # 2. Read the user message [required for both modes] and bound its size.
        user_message = extract_message(req, body)
        if not user_message or not str(user_message).strip():
            return error_response(
                "Input Error.",
                "message is required [query string or JSON body].",
                400, correlation_id,
            )
        user_message = str(user_message)
        if len(user_message) > MAX_MESSAGE_CHARS:
            return error_response(
                "Input Error.",
                f"message exceeds the maximum length of {MAX_MESSAGE_CHARS} characters.",
                400, correlation_id,
            )

        # 3a. DETECT mode -> identify the language with a direct LLM call.
        #     Falls back to the offline py3langid detector if the model is unavailable,
        #     so this endpoint stays up even when the LLM cannot be reached.
        if agent_mode == "detect":
            try:
                config = load_config()
                foundry_service = get_foundry_service(config.foundry)
                detection = foundry_service.detect_language(user_message)
            except Exception:
                logger.exception("LLM detection unavailable; using offline detector.")
                detection = _DETECTOR.detect(user_message)

            logger.info(
                "detect complete.",
                extra={
                    "agent": "detect",
                    "engine": detection.get("engine"),
                    "code": detection.get("code"),
                    "supported": detection.get("supported"),
                    "msg_len": len(user_message),
                    "total_ms": round((time.perf_counter() - request_started) * 1000),
                },
            )
            return json_response(
                {
                    "Success": True,
                    "agent": "detect",
                    "supported": detection["supported"],
                    "language": detection["language"],
                    "code": detection["code"],
                    "confidence": detection["confidence"],
                    "engine": detection.get("engine"),
                    "correlation_id": correlation_id,
                    "message": detection["message"],
                }
            )

        # 3b. TRANSLATE mode -> translate the message into the requested language.
        if agent_mode == "translate":
            target_language = resolve_language(extract_lang(req, body))
            if not target_language:
                return error_response(
                    "Input Error.",
                    "'lang' is required for translate and must be a supported language. "
                    + NOT_SUPPORTED_MESSAGE,
                    400, correlation_id,
                )

            # Load configuration + cached service, then call the model directly.
            #
            # Translate has NO offline fallback, so an upstream failure must surface as a 502
            # (a gateway failure) rather than escaping to the catch-all as an opaque 500. The
            # hint carries the exception class and upstream HTTP status only — enough to tell
            # a wrong deployment name (404) from a missing role assignment (401/403) without
            # leaking any internal detail.
            try:
                config = load_config()
                foundry_service = get_foundry_service(config.foundry)
                reply = foundry_service.translate_message(user_message, target_language)
            except Exception as exc:
                hint = upstream_hint(exc)
                logger.exception(
                    "Translation failed upstream (%s, deployment=%s).",
                    hint, os.getenv("AZURE_OPENAI_DEPLOYMENT", _DEFAULT_DEPLOYMENT),
                    extra={"upstream_hint": hint},
                )
                return error_response(
                    "Translation failed.",
                    f"The translation service could not be reached [{hint}]. Please retry, "
                    f"and quote correlation_id '{correlation_id}' if it persists.",
                    502, correlation_id,
                )

            if not reply:
                # Upstream produced nothing usable -> tell the caller to retry (502).
                return error_response(
                    "Translation failed.",
                    "The translation service did not return a result. Please retry.",
                    502, correlation_id,
                )

            logger.info(
                "translate complete.",
                extra={
                    "agent": "translate",
                    "target_language": target_language,
                    "msg_len": len(user_message),
                    "reply_len": len(reply),
                    "total_ms": round((time.perf_counter() - request_started) * 1000),
                },
            )
            return json_response(
                {
                    "Success": True,
                    "agent": "translate",
                    "language": target_language,
                    "environment": config.environment,
                    "correlation_id": correlation_id,
                    "reply": reply,
                }
            )

        # 4. Missing / unknown agent -> tell the caller the valid options.
        return error_response(
            "Input Error.",
            "agent is required and must be 'detect' or 'translate'.",
            400, correlation_id,
        )

    except Exception:
        # Final safeguard: log the full stack trace server-side, but NEVER leak internal
        # exception detail to the caller. The correlation_id lets support find the log.
        logger.exception("Unhandled exception in Multilingual Agent function.")
        return error_response(
            "Unhandled server error. Please contact the automation team.",
            f"An unexpected error occurred. Quote correlation_id '{correlation_id}' to support.",
            500, correlation_id,
        )
