# Inject the current correlation id onto every record so it surfaces in App Insights.
# Without this, correlation would have to be passed manually to every log call,
# which is easy to forget and impossible to enforce.
class _CorrelationIdFilter(logging.Filter):     # logging.Filter subclass used purely to enrich records  # log filter

    def filter(self, record: logging.LogRecord) -> bool:  # noqa: A003   # called by logging for every record  # enrich hook
        if not hasattr(record, "correlation_id"):   # never overwrite a caller-supplied value  # respect explicit extra=
            record.correlation_id = _correlation_id_var.get()   # stamp the current request's id onto the record  # attach id
        return True                             # this filter only enriches; it never drops a record  # always keep


logger.addFilter(_CorrelationIdFilter())        # register the filter once at import time  # wire it up


