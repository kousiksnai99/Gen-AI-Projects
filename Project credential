# Build a JSON HTTP response. ensure_ascii=False keeps non-Latin scripts (Hebrew, Japanese,
# Chinese, ...) readable in the body instead of being escaped to \uXXXX. Centralising response
# construction keeps the contract identical on every path.
def json_response(payload: Dict[str, Any], status: int = 200) -> func.HttpResponse:    # payload: body to serialise, status: HTTP status  # response writer
    return func.HttpResponse(                   # single place where every response is constructed  # build response
        body=json.dumps(payload, ensure_ascii=False),   # serialise without escaping non-Latin scripts  # JSON body
        status_code=status,                     # HTTP status requested by the caller  # status code
        mimetype="application/json",            # tell clients the body is JSON  # content type
    )


# Standard error envelope. Always carries the correlation_id so callers can quote it: one shape
# for every failure means clients need a single error parser, and support can always trace a
# complaint back to the exact request via the correlation id.
def error_response(                         # one envelope shape for every failure  # error writer
    message: str, details: str, status: int, correlation_id: str     # user-facing message, detail, status, trace id  # arguments
) -> func.HttpResponse:                     # always a JSON HttpResponse  # return type
    return json_response(                       # reuse the standard JSON writer  # delegate
        {                                   # uniform error body the clients parse  # payload
            "Success": False,                   # uniform failure flag for every error path  # result
            "error": {"message": message, "details": details},  # short message plus safe detail  # error block
            "correlation_id": correlation_id,   # lets the caller quote the request to support  # trace id
        },
        status=status,                          # 400 / 502 / 500 as decided by the caller  # status code
    )


