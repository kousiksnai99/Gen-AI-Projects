# Normalise whatever endpoint an operator typed into the v1 base URL the client needs. Accepts the
# full '.../openai/v1' form or a bare resource URL, because "which suffix does it want?" is an easy
# App Setting to get wrong and the failure would be a confusing 404 at runtime.
def _normalise_openai_endpoint(endpoint: str) -> str:    # endpoint: the raw App Setting value  # endpoint normaliser
    endpoint = endpoint.strip().rstrip("/")     # a trailing slash would double up in the URL join  # trim
    if endpoint.endswith("/openai/v1"):         # already the v1 base URL  # correct form
        return endpoint                         # nothing to do  # as-is
    if endpoint.endswith("/openai"):            # resource URL with the /openai prefix only  # partial form
        return endpoint + "/v1"                 # complete it  # append version
    return endpoint + "/openai/v1"              # bare resource URL -> add the full v1 path  # append path


# Build the AppConfig from App Settings, so every value is overridable WITHOUT a code redeploy
# via Function App -> Configuration -> Application settings. This keeps deployment-specific
# values out of the code and avoids embedded secrets.
def load_config() -> AppConfig:             # reads every value from App Settings  # config loader
    openai_endpoint = os.getenv("AZURE_OPENAI_ENDPOINT", _DEFAULT_OPENAI_ENDPOINT)   # AZURE_OPENAI_ENDPOINT App Setting wins  # read endpoint
    if not os.getenv("AZURE_OPENAI_ENDPOINT"):  # running on the built-in value  # unconfigured
        # Not fatal (keeps the POC working out of the box) but flagged so prod can't rely on it.
        logger.warning("AZURE_OPENAI_ENDPOINT not set; using the built-in default endpoint.")    # visible in App Insights  # warn ops
    deployment = os.getenv("AZURE_OPENAI_DEPLOYMENT", _DEFAULT_DEPLOYMENT)   # AZURE_OPENAI_DEPLOYMENT App Setting wins  # read deployment
    if not os.getenv("AZURE_OPENAI_DEPLOYMENT"):    # a wrong deployment name is a 404 from the service  # unconfigured
        # Informational: the built-in default matches the POC deployment, so this is not an error.
        logger.info("AZURE_OPENAI_DEPLOYMENT not set; using the built-in default '%s'.", _DEFAULT_DEPLOYMENT)   # note the default  # info log
    llm_cfg = LlmConfig(                        # assemble the model configuration block  # build llm config
        openai_endpoint=_normalise_openai_endpoint(openai_endpoint),   # accepts the bare resource URL too  # openai endpoint
        deployment=deployment,                  # model deployment name used as `model`  # deployment
        api_version=os.getenv("AZURE_OPENAI_API_VERSION", _DEFAULT_API_VERSION),     # AZURE_OPENAI_API_VERSION App Setting  # api version
    )
    return AppConfig(environment=os.getenv("ENVIRONMENT", "dev"), llm=llm_cfg)  # ENVIRONMENT App Setting, free-text label  # return config


