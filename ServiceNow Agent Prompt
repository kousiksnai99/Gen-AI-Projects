## Business owner , Team : Data and AIA                                             #
## Purpose of Function:                                                             #
##   HTTP-triggered Azure Function that fronts the ServiceNow ticketing agent.      #
##   It parses the orchestrator's "action=... | key=value" message and returns the  #
##   interaction / incident ids in the exact fields the orchestrator reads.         #
##                                                                                  #
##   Two modes (SERVICENOW_MOCK_MODE):                                              #
##     true  (default) -> returns fake ids, no external calls (unchanged behavior). #
##     false           -> forwards the message to the real Foundry 'servicenow-agent'#
##                        (Responses API + agent_reference) and returns its result. #
##                                                                                  #
##   Actions handled (must match the orchestrator's snow_* helpers):               #
##     action=create_interaction | user=<user_id>                                   #
##         -> {"interaction_id": "IMS0001234", "message": "..."}                    #
##     action=close_interaction  | interaction_id=<id>                              #
##         -> {"message": "..."}                                                    #
##     action=create_incident    | interaction_id=<id> | issue_type=<..> |          #
##                                 details=<..>                                     #
##         -> {"incident_id": "INC0009876", "message": "..."}                       #
##     action=update_incident    | incident_id=<id> | note=<..>                     #
##         -> {"incident_id": "INC0009876", "message": "..."}                       #
##     action=resolve            | interaction_id=<id> | incident_id=<id>           #
##         -> {"message": "..."}                                                    #
#####################################################################################

# # Load all the libraries
import json
import logging
import os
import random
import re

import azure.functions as func


#=============================Logging Setup========================================================
logging.getLogger().setLevel(logging.INFO)


#=============================Configuration========================================================
# When MOCK_MODE is false the function calls the real Foundry 'servicenow-agent';
# when true it returns fake ids. Default is false here so the agent is active.
MOCK_MODE = os.getenv("SERVICENOW_MOCK_MODE", "false").strip().lower() in ("1", "true", "yes", "on")

# Foundry 'servicenow-agent' settings. Hardcoded here because app settings aren't used;
# an env var still overrides if one is ever set. NOTE: rotate this key after go-live.
FOUNDRY_PROJECT_ENDPOINT = os.getenv(
    "FOUNDRY_PROJECT_ENDPOINT",
    "https://aifoundry-rjteh-ais-swce-poc.services.ai.azure.com/api/projects/aifp-uqqnf-ais-swce-poc",
)
FOUNDRY_API_KEY = os.getenv(
    "AZURE_OPENAI_API_KEY",
    "G3T2HOKaVUTwDmDkV0OaEOrlsjO90eJPfaWZErYpODlIvzuOhEMoJQQJ99BJACfhMk5XJ3w3AAAAACOG8gdK",
)
AGENT_NAME = os.getenv("AGENT_NAME", "servicenow-agent")


#==============================================Utilities===========================================
def json_response(payload: dict, status: int = 200) -> func.HttpResponse:
    """Return a JSON HTTP response (ensure_ascii=False keeps any non-Latin text readable)."""
    return func.HttpResponse(
        body=json.dumps(payload, ensure_ascii=False),
        status_code=status,
        mimetype="application/json",
    )


def extract_message(req: func.HttpRequest) -> str:
    """Read the orchestrator's 'message' (the action string) from body or query.

    The orchestrator POSTs {"conversation_id": ..., "message": "action=... | ..."}.
    We also accept ?message=... for quick manual curl testing.
    """
    try:
        body = req.get_json()
    except ValueError:
        body = None
    if isinstance(body, dict) and body.get("message"):
        return str(body.get("message"))
    return req.params.get("message", "") or ""


def parse_action(message: str) -> dict:
    """Parse 'action=create_incident | interaction_id=IMS1 | details=...' into a dict.

    Splits on '|' then on the FIRST '=' so a value may itself contain '='. NOTE: if a
    free-text value (e.g. details) contains a literal '|', it will be truncated at that
    pipe -- fine for a dummy, but a real agent should use a JSON body to avoid this.
    """
    fields: dict = {}
    for part in (message or "").split("|"):
        part = part.strip()
        if not part or "=" not in part:
            continue
        key, value = part.split("=", 1)
        fields[key.strip()] = value.strip()
    return fields


def fake_number(prefix: str) -> str:
    """Fake ServiceNow-style record number, e.g. INC0012345 / IMS0007654."""
    return f"{prefix}{random.randint(0, 9999999):07d}"


#==============================================Real Foundry agent==================================
def call_agent(message: str) -> str:
    """Forward the orchestrator's action string to the real Foundry 'servicenow-agent' and
    return its reply text. Uses the OpenAI-compatible Responses API on the project endpoint
    with an 'agent_reference', authenticated with the API key."""
    if not FOUNDRY_PROJECT_ENDPOINT or not FOUNDRY_API_KEY:
        raise RuntimeError(
            "Real-agent mode is on but FOUNDRY_PROJECT_ENDPOINT / AZURE_OPENAI_API_KEY are not set."
        )
    from openai import OpenAI  # lazy import so mock mode never needs the package at runtime

    client = OpenAI(
        base_url=FOUNDRY_PROJECT_ENDPOINT.rstrip("/") + "/openai/v1",
        api_key=FOUNDRY_API_KEY,
        timeout=60,
    )
    prompt = (
        f"{message}\n\n"
        'Reply ONLY with a compact JSON object using these keys: "interaction_id", '
        '"incident_id", "message". Use empty strings for any that do not apply.'
    )
    resp = client.responses.create(
        input=prompt,
        extra_body={"agent_reference": {"type": "agent_reference", "name": AGENT_NAME}},
    )
    return resp.output_text or ""


def _parse_agent_json(text: str) -> dict:
    """Best-effort parse of the agent reply into a dict; falls back to {'message': text}."""
    text = (text or "").strip()
    candidates = [text]
    if "{" in text and "}" in text:
        candidates.append(text[text.find("{"): text.rfind("}") + 1])
    for candidate in candidates:
        try:
            obj = json.loads(candidate)
        except ValueError:
            continue
        if isinstance(obj, dict):
            return obj
    return {"message": text}


def _find_number(text: str, prefix: str) -> str:
    """Pull a ServiceNow-style number (e.g. INC0012345 / IMS0007654) out of free text."""
    match = re.search(rf"\b{prefix}\d+\b", text or "")
    return match.group(0) if match else ""


def agent_result(action: str, fields: dict, message: str) -> dict:
    """Call the real agent and shape its reply into the SAME fields the orchestrator reads,
    so the response contract is identical to mock mode. The ticket numbers come from the
    agent -- taken from its JSON reply, else parsed out of its text -- never faked."""
    reply = call_agent(message)
    data = _parse_agent_json(reply)
    interaction_id = str(data.get("interaction_id") or _find_number(reply, "IMS") or fields.get("interaction_id", ""))
    incident_id = str(data.get("incident_id") or _find_number(reply, "INC") or fields.get("incident_id", ""))
    msg = str(data.get("message") or reply or "")

    if action == "create_interaction":
        return {"interaction_id": interaction_id, "user": fields.get("user", ""), "message": msg}
    if action == "close_interaction":
        return {"interaction_id": interaction_id, "message": msg}
    if action == "create_incident":
        return {
            "incident_id": incident_id,
            "interaction_id": interaction_id,
            "issue_type": fields.get("issue_type", ""),
            "message": msg,
        }
    if action == "update_incident":
        return {"incident_id": incident_id, "note": fields.get("note", ""), "message": msg}
    if action == "resolve":
        return {"incident_id": incident_id, "interaction_id": interaction_id, "message": msg}
    return {"message": msg or "ServiceNow: no matching action.", "action": action}


#==============================================Azure Function Entry================================
def main(req: func.HttpRequest) -> func.HttpResponse:
    """HTTP entry point: parse the action and return a mocked or real ServiceNow result."""
    message = extract_message(req)
    fields = parse_action(message)
    action = fields.get("action", "")
    logging.info("ServiceNow: mock=%s action=%s fields=%s", MOCK_MODE, action, fields)

    try:
        # Real-agent mode: delegate to the Foundry 'servicenow-agent' and return the same
        # structured fields the orchestrator reads. Toggle with SERVICENOW_MOCK_MODE.
        if not MOCK_MODE:
            return json_response(agent_result(action, fields, message))

        if action == "create_interaction":
            interaction_id = fake_number("IMS")
            return json_response(
                {
                    "interaction_id": interaction_id,
                    "user": fields.get("user", ""),
                    "message": f"Interaction {interaction_id} created.",
                }
            )

        if action == "close_interaction":
            interaction_id = fields.get("interaction_id", "")
            return json_response(
                {
                    "interaction_id": interaction_id,
                    "message": f"Interaction {interaction_id} closed.",
                }
            )

        if action == "create_incident":
            incident_id = fake_number("INC")
            interaction_id = fields.get("interaction_id", "")
            under = f" under interaction {interaction_id}" if interaction_id else ""
            return json_response(
                {
                    "incident_id": incident_id,
                    "interaction_id": interaction_id,
                    "issue_type": fields.get("issue_type", ""),
                    "message": f"Incident {incident_id} has been created{under}.",
                }
            )

        if action == "update_incident":
            incident_id = fields.get("incident_id", "")
            return json_response(
                {
                    "incident_id": incident_id,
                    "note": fields.get("note", ""),
                    "message": f"Incident {incident_id} updated.",
                }
            )

        if action == "resolve":
            incident_id = fields.get("incident_id", "")
            return json_response(
                {
                    "incident_id": incident_id,
                    "interaction_id": fields.get("interaction_id", ""),
                    "message": f"Incident {incident_id} has been resolved.",
                }
            )

        # Unknown / empty action -> harmless ack so the orchestrator never breaks.
        return json_response(
            {"message": "ServiceNow (dummy): no matching action.", "action": action}
        )

    except Exception as exc:  # final safety net
        logging.exception("ServiceNow agent error")
        return json_response(
            {"message": "ServiceNow agent error.", "details": str(exc)},
            status=500,
        )


